# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Directory where per-user SQLite databases are stored (inside the container).
REVOLUT_DATA_DIR=/data

# Resend API key for transactional email (invite links).
# Get one at https://resend.com
RESEND_API_KEY=re_your_key_here

# "From" address for invite emails.  Must be a verified domain in Resend.
RESEND_FROM=noreply@yourdomain.com

# Public base URL of your deployment (used to build invite links).
APP_BASE_URL=https://yourdomain.com

# Stripe webhook signing secret (from the Stripe dashboard → Webhooks).
# Only required if you use Stripe for premium provisioning.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
