# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Directory where per-user SQLite databases are stored (inside the container).
REVOLUT_DATA_DIR=/data

# Resend API key for transactional email (invite links).
# Get one at https://resend.com
RESEND_API_KEY=re_your_key_here

# "From" address for invite emails.  Must be a verified domain in Resend.
RESEND_FROM=noreply@yourdomain.com

# Public base URL of your deployment (used to build invite links).
APP_BASE_URL=https://yourdomain.com

# Stripe webhook signing secret (from the Stripe dashboard → Webhooks).
# Only required if you use Stripe for premium provisioning.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Stripe Checkout URL for the premium subscription.
# Create a Payment Link in the Stripe dashboard and paste it here.
# If unset, the pricing page will show "Coming soon" instead of the buy button.
STRIPE_CHECKOUT_URL=https://buy.stripe.com/your_payment_link

# Force HTTPS: redirect HTTP→HTTPS and send HSTS headers.
# Set to true when running behind a TLS-terminating reverse proxy.
FORCE_HTTPS=false

# Stripe Customer Portal URL (for subscribers to manage billing, cancel, download invoices).
# Enable the Customer Portal in the Stripe dashboard → Billing → Customer portal.
# If unset, the Settings page will show a "Contact support" message instead.
STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/your_portal_link
