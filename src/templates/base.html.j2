<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% block meta %}{% endblock %}

  {# PWA Meta Tags #}
  <meta name="description" content="Stock portfolio analytics and tax reporting for Slovenian investors">
  <meta name="theme-color" content="#4f46e5">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WealthEagle">

  {# PWA Manifest and Icons #}
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/x-icon" href="/static/icons/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/static/icons/favicon-16.png">
  <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">

  {{ fouc_script|safe }}
  <title>{% block title %}WealthEagle{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/common.css">
  {% block extra_css %}{% endblock %}
</head>
<body>
  <a href="#main-content" class="skip-to-content">Skip to content</a>

  {# Offline Detection Banner #}
  <div id="offline-banner" class="offline-banner" style="display: none;">
    <div class="offline-banner-content">
      <svg class="offline-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="1" y1="1" x2="23" y2="23"></line>
        <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
        <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
        <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
        <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
        <line x1="12" y1="20" x2="12.01" y2="20"></line>
      </svg>
      <span class="offline-text">You're offline. Some features may be unavailable.</span>
    </div>
    <button class="offline-dismiss" onclick="dismissOfflineBanner()" aria-label="Dismiss offline notice">×</button>
  </div>

  {% block header %}
    {% if show_header %}
      {% include "partials/nav.html.j2" %}
    {% endif %}
  {% endblock %}

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {% if show_drop_import %}
    {% include "partials/drop_import.html.j2" %}
  {% endif %}

  {{ common_js|safe }}
  {% block extra_js %}{% endblock %}

  {# PWA Service Worker Registration #}
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then(function(registration) {
          console.log('Service Worker registered with scope:', registration.scope);
        })
        .catch(function(error) {
          console.error('Service Worker registration failed:', error);
        });
    }
  </script>

  {# Offline Detection Banner #}
  <script>
    let offlineBannerDismissed = false;

    function showOfflineBanner() {
      if (!offlineBannerDismissed) {
        const banner = document.getElementById('offline-banner');
        if (banner) {
          banner.style.display = 'flex';
        }
      }
    }

    function hideOfflineBanner() {
      const banner = document.getElementById('offline-banner');
      if (banner) {
        banner.style.display = 'none';
      }
      offlineBannerDismissed = false; // Reset for next offline event
    }

    function dismissOfflineBanner() {
      offlineBannerDismissed = true;
      hideOfflineBanner();
    }

    // Listen for online/offline events
    window.addEventListener('online', function() {
      console.log('[PWA] Network connection restored');
      hideOfflineBanner();
    });

    window.addEventListener('offline', function() {
      console.log('[PWA] Network connection lost');
      showOfflineBanner();
    });

    // Check initial state on page load
    if (!navigator.onLine) {
      showOfflineBanner();
    }
  </script>
</body>
</html>
