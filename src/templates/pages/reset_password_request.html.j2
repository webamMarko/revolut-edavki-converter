{% extends "base.html.j2" %}

{% block title %}Reset Password — WealthEagle{% endblock %}

{% block extra_css %}
<style>body{display:flex;align-items:center;justify-content:center;padding:1rem}</style>
{% endblock %}

{% block content %}
<div class="auth-card">
  <button class="theme-toggle auth-theme-toggle" onclick="toggleTheme()"><span class="theme-icon"></span></button>
  <div class="auth-card logo">
    <a href="/" style="text-decoration:none;color:inherit;display:flex;align-items:center;gap:0.5rem;justify-content:center">
      <img src="/static/logo.png" alt="WealthEagle" style="height:2.5rem;width:auto">
      <span>WealthEagle<span class="brand-accent">.</span></span>
    </a>
  </div>
  <h1 style="font-size:1.1rem;font-weight:700;margin-bottom:0.25rem;text-align:center">Forgot your password?</h1>
  <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:1rem;text-align:center">Enter your email and we'll send you a reset link.</p>
  {% if error %}
    <p class="auth-error">{{ error }}</p>
  {% endif %}
  {% if success %}
    <p style="color:var(--green);font-size:0.85rem;margin-top:0.5rem;text-align:center">{{ success }}</p>
  {% endif %}
  <form method="POST" action="/reset-password">
    <label>Email</label>
    <input type="email" name="email" autocomplete="email" required placeholder="you@example.com">
    <button class="btn btn-primary" type="submit" style="width:100%;margin-top:0.75rem">Send reset link</button>
  </form>
  <p style="text-align:center;font-size:0.82rem;margin-top:1rem"><a href="/login" style="color:var(--accent)">Back to log in</a></p>
</div>
{% endblock %}
