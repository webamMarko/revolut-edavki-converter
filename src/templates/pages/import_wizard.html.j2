{% extends "base.html.j2" %}

{% block meta %}
<meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block title %}Import Wizard — WealthEagle{% endblock %}

{% block extra_css %}
<style>.app-main{max-width:780px}</style>
{% endblock %}

{% block content %}
<div class="app-main">
  <!-- Announcement region for screen readers -->
  <div id="stepAnnounce" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <div id="acDetectAnnounce" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <div id="acOverrideAnnounce" aria-live="polite" aria-atomic="true" class="sr-only"></div>
  <!-- Column inspector announcements for screen readers -->
  <div id="ci-announce" aria-live="polite" aria-atomic="true" class="sr-only"></div>

  <!-- Import History Card -->
  <div class="card" id="historyCard" style="display:none;margin-bottom:1rem;padding:.75rem 1rem;background:var(--bg-alt,#f8f9fa);border:1px solid var(--border,#e0e0e0)">
    <div style="font-size:.8rem;font-weight:600;color:var(--muted);margin-bottom:.4rem">Portfolio Summary</div>
    <div id="historyContent"></div>
  </div>

  <!-- Accordion wizard -->
  <div class="wz-accordion" id="wizard">

    <!-- Step 1: Upload -->
    <div class="wz-step wz-step--active" id="ws1">
      <button class="wz-hdr" id="wh1" aria-expanded="true" aria-controls="wb1"
              aria-label="Step 1 of 4: Upload CSV, current">
        <span class="wz-indicator" aria-hidden="true">
          <span class="wz-num">1</span>
          <span class="wz-check">&#10003;</span>
        </span>
        <span class="wz-title">Upload CSV</span>
        <span class="wz-badge">Current</span>
        <span class="wz-summary" id="wsum1"></span>
      </button>
      <div class="wz-body" id="wb1" role="region" aria-labelledby="wh1">
        <div class="wz-body-inner">
          <div class="drop-zone" id="dropZone">
            <div class="icon" aria-hidden="true">&#128196;</div>
            <div class="lbl">Drop CSV here or <strong>browse</strong></div>
            <div class="hint">CSV only &mdash; comma or semicolon separated</div>
            <input type="file" id="fileInput" accept=".csv" aria-label="Upload CSV file">
          </div>
          <div class="chosen-file" id="chosenFile" aria-live="polite"></div>
          <div class="error-msg" id="step1Err" aria-live="polite" aria-atomic="true"></div>
          <div class="btn-group">
            <button class="btn btn-primary" id="previewBtn" disabled>Next: Map Columns</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 2: Map Columns -->
    <div class="wz-step wz-step--pending" id="ws2">
      <button class="wz-hdr" id="wh2" aria-expanded="false" aria-controls="wb2" disabled
              aria-label="Step 2 of 4: Map Columns, not yet available">
        <span class="wz-indicator" aria-hidden="true">
          <span class="wz-num">2</span>
          <span class="wz-check">&#10003;</span>
        </span>
        <span class="wz-title">Map Columns</span>
        <span class="wz-badge">Pending</span>
        <span class="wz-summary" id="wsum2"></span>
      </button>
      <div class="wz-body wz-body--collapsed" id="wb2" role="region" aria-labelledby="wh2" hidden>
        <div class="wz-body-inner">
          <div class="detection-card" id="detectionCard">
            <p class="detection-question" id="ac-question">What type of trades are in this file?</p>
            <div class="ac-toggles" id="acToggles" role="radiogroup" aria-labelledby="ac-question">
              <button class="ac-btn" data-ac="stock" role="radio" aria-checked="false" tabindex="0"
                      aria-label="Stock: Company shares">
                <span class="ac-btn-icon" aria-hidden="true">&#128200;</span>
                <span class="ac-btn-label">Stock</span>
                <span class="ac-btn-desc">Company shares</span>
                <span class="detected-badge" id="badge-stock" style="display:none" aria-label="auto-detected">&#10003; Detected</span>
              </button>
              <button class="ac-btn" data-ac="cfd" role="radio" aria-checked="false" tabindex="-1"
                      aria-label="CFD: Contracts for difference (leveraged trading)">
                <span class="ac-btn-icon" aria-hidden="true">&#9889;</span>
                <span class="ac-btn-label">CFD</span>
                <span class="ac-btn-desc">Contracts for difference (leveraged trading)</span>
                <span class="detected-badge" id="badge-cfd" style="display:none" aria-label="auto-detected">&#10003; Detected</span>
              </button>
              <button class="ac-btn" data-ac="crypto" role="radio" aria-checked="false" tabindex="-1"
                      aria-label="Crypto: Bitcoin, Ethereum, etc.">
                <span class="ac-btn-icon" aria-hidden="true">&#8383;</span>
                <span class="ac-btn-label">Crypto</span>
                <span class="ac-btn-desc">Bitcoin, Ethereum, etc.</span>
                <span class="detected-badge" id="badge-crypto" style="display:none" aria-label="auto-detected">&#10003; Detected</span>
              </button>
              <button class="ac-btn" data-ac="savings" role="radio" aria-checked="false" tabindex="-1"
                      aria-label="Savings: Money market funds &amp; savings accounts">
                <span class="ac-btn-icon" aria-hidden="true">&#127974;</span>
                <span class="ac-btn-label">Savings</span>
                <span class="ac-btn-desc">Money market funds &amp; savings accounts</span>
                <span class="detected-badge" id="badge-savings" style="display:none" aria-label="auto-detected">&#10003; Detected</span>
              </button>
            </div>
            <div id="overrideWarning" class="override-warning" style="display:none" role="alert" aria-live="polite">
              <strong>&#9888; Override:</strong> You selected <strong id="owSelectedClass"></strong> but we detected <strong id="owDetectedClass"></strong>. Column mappings will change:
              <div id="overrideDiff" class="col-diff"></div>
            </div>
          </div>

          <div style="font-size:.8rem;font-weight:600;color:var(--muted);margin-bottom:.4rem" id="preview-label">CSV preview (first 5 rows)</div>
          <div class="preview-wrap" role="region" aria-labelledby="preview-label"><table class="preview-table" id="previewTable"></table></div>

          <div style="font-size:.8rem;font-weight:600;color:var(--muted);margin-bottom:.4rem" id="mapping-label">Column mapping</div>
          <table class="map-table" id="mapTable" aria-labelledby="mapping-label"></table>

          <div class="error-msg" id="step2Err" aria-live="polite" aria-atomic="true"></div>
          <div class="btn-group">
            <button class="btn btn-primary" id="nextBtn2" disabled>Next: Validate</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 3: Validate -->
    <div class="wz-step wz-step--pending" id="ws3">
      <button class="wz-hdr" id="wh3" aria-expanded="false" aria-controls="wb3" disabled
              aria-label="Step 3 of 4: Validate, not yet available">
        <span class="wz-indicator" aria-hidden="true">
          <span class="wz-num">3</span>
          <span class="wz-check">&#10003;</span>
        </span>
        <span class="wz-title">Validate</span>
        <span class="wz-badge">Pending</span>
        <span class="wz-summary" id="wsum3"></span>
      </button>
      <div class="wz-body wz-body--collapsed" id="wb3" role="region" aria-labelledby="wh3" hidden>
        <div class="wz-body-inner">
          <div id="validationLoading" style="text-align:center;padding:2rem 0" aria-live="polite">
            <span class="spin" style="display:inline-block;width:20px;height:20px" aria-hidden="true"></span>
            <div id="validationProgressMsg" style="margin-top:.5rem;font-size:.85rem;color:var(--muted)">Validating rows...</div>
          </div>
          <div id="validationResults" style="display:none" aria-live="polite" aria-atomic="false">
            <div id="validationSummary" style="padding:.6rem .8rem;margin-bottom:.75rem;border-radius:6px;font-size:.85rem" role="status"></div>
            <div id="validationIssues"></div>
            <div id="validationMissingBuys"></div>
            <div id="validationDateGaps"></div>
          </div>
          <div class="error-msg" id="step3Err" aria-live="polite" aria-atomic="true"></div>
          <div class="btn-group" id="step3Btns" style="display:none">
            <button class="btn btn-primary" id="nextBtn3">Continue to Import</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Step 4: Review & Import -->
    <div class="wz-step wz-step--pending" id="ws4">
      <button class="wz-hdr" id="wh4" aria-expanded="false" aria-controls="wb4" disabled
              aria-label="Step 4 of 4: Import, not yet available">
        <span class="wz-indicator" aria-hidden="true">
          <span class="wz-num">4</span>
          <span class="wz-check">&#10003;</span>
        </span>
        <span class="wz-title">Import</span>
        <span class="wz-badge">Pending</span>
        <span class="wz-summary" id="wsum4"></span>
      </button>
      <div class="wz-body wz-body--collapsed" id="wb4" role="region" aria-labelledby="wh4" hidden>
        <div class="wz-body-inner">
          <div id="overlapWarning" style="display:none;padding:.6rem .8rem;margin-bottom:.75rem;border-radius:6px;background:#fff8e1;border:1px solid #ffe082;font-size:.82rem;color:#6d4c00" role="alert"></div>
          <div class="summary-list" id="summaryList"></div>
          <div class="error-msg" id="step4Err" aria-live="polite" aria-atomic="true"></div>
          <div id="successBox" style="display:none" aria-live="polite" role="status"></div>
          <div class="btn-group" id="step4Btns">
            <button class="btn btn-primary" id="importBtn">Import</button>
          </div>
        </div>
      </div>
    </div>

  </div><!-- end .wz-accordion -->
</div>

<!-- ── Column Inspector Panel ──────────────────────────────────────── -->
<div id="columnInspector" class="ci-panel" role="dialog" aria-modal="true"
     aria-labelledby="ci-col-name" aria-hidden="true">
  <div class="ci-inner">
    <!-- Header -->
    <div class="ci-hdr">
      <span id="ci-col-name" class="ci-col-name"></span>
      <button id="ci-close" class="ci-close-btn" aria-label="Close column inspector">&#10005;</button>
    </div>

    <!-- Content -->
    <div id="ci-content" class="ci-content">
      <div class="ci-meta">
        <span id="ci-type-badge" class="ci-type-badge"></span>
        <div id="ci-mapped-field" class="ci-mapped-field"></div>
      </div>

      <!-- Unmapped column section — shown only when column has no mapping -->
      <div id="ci-unmapped-section" class="ci-unmapped-section" style="display:none">
        <span class="ci-unmapped-badge">Unmapped</span>
        <button id="ci-map-this" class="btn btn-primary btn-sm">Map this column</button>
      </div>

      <div class="ci-samples-section">
        <div class="ci-section-label">Sample values</div>
        <div id="ci-samples" class="ci-samples"></div>
      </div>

      <div id="ci-transform-preview" class="ci-transform-preview"></div>
    </div>

    <!-- Actions -->
    <div class="ci-actions">
      <button id="ci-looks-good" class="btn btn-primary btn-sm">Looks good</button>
      <button id="ci-fix-this" class="btn btn-secondary btn-sm">Fix this</button>
      <button id="ci-change-mapping" class="btn btn-secondary btn-sm">Change mapping</button>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
const DB_FIELDS = {
  stock:   { required: ["date","type"], optional: ["ticker","quantity","price_per_share","total_amount","currency","fx_rate"] },
  cfd:     { required: ["date","type","ticker"], optional: ["quantity","price_per_share","total_amount","currency","fx_rate"] },
  crypto:  { required: ["date","type","ticker"], optional: ["quantity","price_per_share","total_amount"] },
  savings: { required: ["date","type"], optional: ["ticker","quantity","price_per_share","total_amount","fx_rate"] },
};
const FIELD_LABELS = {
  date:"Date", ticker:"Ticker / Symbol", type:"Transaction Type",
  quantity:"Quantity", price_per_share:"Price per Share",
  total_amount:"Total Amount", currency:"Currency", fx_rate:"FX Rate",
};
const FIELD_ALIASES = {
  date:            ["date","started date","datevalue","settlementdate","started_date"],
  ticker:          ["ticker","symbol","financialinstrument"],
  type:            ["type","transactiontypename","transaction type"],
  quantity:        ["quantity","volume","volumevalue","quantity of shares","qty"],
  price_per_share: ["price per share","price","pricevalue","price_per_share"],
  total_amount:    ["total amount","amount","value","total_amount"],
  currency:        ["currency","ccy"],
  fx_rate:         ["fx rate","fxrate","fx_rate","exchange rate"],
};

const STEP_LABELS = ['Upload CSV', 'Map Columns', 'Validate', 'Import'];

let _headers = [], _rows = [], _filename = '', _rowCount = 0;
let _assetClass = null;
let _statusData = null;
let _currentStep = 1;
let _validationData = null;

// Detection state (Phase 2)
let _detectedClass = null;
let _detectionConfidence = 0;
let _isOverridden = false;

// Summaries shown in completed step headers
const _stepSummaries = { 1: '', 2: '', 3: '' };

(async function loadHistory() {
  try {
    const resp = await fetch('/status');
    const data = await resp.json();
    _statusData = data;
    const card = document.getElementById('historyCard');
    const content = document.getElementById('historyContent');
    if (!data.has_data) {
      card.style.display = '';
      content.innerHTML = '<div style="font-size:.85rem;color:var(--muted)">No data imported yet. Upload your first CSV to get started.</div>';
      return;
    }
    const classes = Object.keys(data.asset_classes || {}).join(', ') || 'none';
    const range = data.date_range ? data.date_range[0] + ' to ' + data.date_range[1] : 'N/A';
    let html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:.3rem .8rem;font-size:.84rem">';
    html += '<div><strong>' + data.import_count + '</strong> imports</div>';
    html += '<div><strong>' + data.transaction_count + '</strong> transactions</div>';
    html += '<div>Date range: <strong>' + range + '</strong></div>';
    html += '<div>Asset classes: <strong>' + classes + '</strong></div>';
    html += '</div>';
    card.style.display = '';
    content.innerHTML = html;
  } catch(e) {}
})();

function esc(s) { const d = document.createElement('div'); d.textContent = String(s); return d.innerHTML; }

// ── Accordion state management ────────────────────────────────────────

function announce(msg) {
  const el = document.getElementById('stepAnnounce');
  el.textContent = '';
  requestAnimationFrame(() => { el.textContent = msg; });
}

function _announceDetect(msg) {
  const el = document.getElementById('acDetectAnnounce');
  el.textContent = '';
  requestAnimationFrame(() => { el.textContent = msg; });
}

function _announceOverride(msg) {
  const el = document.getElementById('acOverrideAnnounce');
  el.textContent = '';
  requestAnimationFrame(() => { el.textContent = msg; });
}

function setStep(n) {
  _currentStep = n;
  [1, 2, 3, 4].forEach(i => {
    const step = document.getElementById('ws' + i);
    const hdr  = document.getElementById('wh' + i);
    const body = document.getElementById('wb' + i);
    const badge = hdr.querySelector('.wz-badge');
    const sumEl = document.getElementById('wsum' + i);

    step.classList.remove('wz-step--active', 'wz-step--done', 'wz-step--pending');

    if (i < n) {
      // Completed step
      step.classList.add('wz-step--done');
      hdr.disabled = false;
      hdr.setAttribute('aria-expanded', 'false');
      hdr.setAttribute('aria-label', 'Step ' + i + ' of 4: ' + STEP_LABELS[i-1] + ', completed — click to edit');
      badge.textContent = 'Completed';
      if (sumEl) sumEl.textContent = _stepSummaries[i] || '';
      body.hidden = true;
      body.classList.add('wz-body--collapsed');
    } else if (i === n) {
      // Active step
      step.classList.add('wz-step--active');
      hdr.disabled = true;
      hdr.setAttribute('aria-expanded', 'true');
      hdr.setAttribute('aria-label', 'Step ' + i + ' of 4: ' + STEP_LABELS[i-1] + ', current');
      badge.textContent = 'Current';
      if (sumEl) sumEl.textContent = '';
      body.hidden = false;
      body.classList.remove('wz-body--collapsed');
    } else {
      // Pending step
      step.classList.add('wz-step--pending');
      hdr.disabled = true;
      hdr.setAttribute('aria-expanded', 'false');
      hdr.setAttribute('aria-label', 'Step ' + i + ' of 4: ' + STEP_LABELS[i-1] + ', not yet available');
      badge.textContent = 'Pending';
      if (sumEl) sumEl.textContent = '';
      body.hidden = true;
      body.classList.add('wz-body--collapsed');
    }
  });

  announce('Step ' + n + ' of 4: ' + STEP_LABELS[n-1]);
}

// Click handlers for completed step headers — navigate back
[1, 2, 3, 4].forEach(i => {
  document.getElementById('wh' + i).addEventListener('click', () => {
    if (document.getElementById('wh' + i).disabled) return;
    navigateToStep(i);
  });
});

function navigateToStep(target) {
  if (target >= _currentStep) return;
  // Clear summaries for steps at and after target
  for (let j = target; j <= 4; j++) _stepSummaries[j] = '';
  if (target === 1) {
    previewBtn.disabled = !_selectedFile;
    previewBtn.textContent = 'Next: Map Columns';
    document.getElementById('step1Err').textContent = '';
    // Re-upload resets detection state
    _detectedClass = null;
    _detectionConfidence = 0;
    _isOverridden = false;
  }
  if (target <= 2) {
    _validationData = null;
    document.getElementById('validationResults').style.display = 'none';
    document.getElementById('validationLoading').style.display = '';
    document.getElementById('step3Btns').style.display = 'none';
    document.getElementById('step3Err').textContent = '';
    document.getElementById('validationProgressMsg').textContent = 'Validating rows...';
  }
  setStep(target);
}

// ── File pick ─────────────────────────────────────────────────────────

const dropZone = document.getElementById('dropZone');
const fileInput = document.getElementById('fileInput');
const chosenFile = document.getElementById('chosenFile');
const previewBtn = document.getElementById('previewBtn');
const step1Err = document.getElementById('step1Err');

let _selectedFile = null;

dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e => {
  e.preventDefault(); dropZone.classList.remove('dragover');
  const f = e.dataTransfer.files[0];
  if (f) setFile(f);
});
fileInput.addEventListener('change', () => { if (fileInput.files[0]) setFile(fileInput.files[0]); fileInput.value=''; });

function setFile(f) {
  if (!f.name.toLowerCase().endsWith('.csv')) {
    step1Err.textContent = 'Only CSV files are supported.'; return;
  }
  _selectedFile = f;
  const size = f.size > 1048576 ? (f.size/1048576).toFixed(1)+' MB' : Math.ceil(f.size/1024)+' KB';
  chosenFile.textContent = f.name + ' (' + size + ')';
  previewBtn.disabled = false;
  step1Err.textContent = '';
}

// ── Step 1 → 2 ────────────────────────────────────────────────────────

previewBtn.addEventListener('click', async () => {
  if (!_selectedFile) return;
  previewBtn.disabled = true;
  previewBtn.innerHTML = '<span class="spin"></span> Loading...';
  step1Err.textContent = '';
  const form = new FormData();
  form.append('file', _selectedFile);
  try {
    const resp = await fetch('/import/preview', { method: 'POST', body: form });
    const data = await resp.json();
    if (data.error) { step1Err.textContent = data.error; previewBtn.disabled = false; previewBtn.textContent = 'Next: Map Columns'; return; }
    _headers = data.headers;
    _rows = data.rows;
    _rowCount = data.row_count;
    _filename = data.filename;
    _stepSummaries[1] = _filename + ' (' + _rowCount.toLocaleString() + ' rows)';
    // Reset detection state for fresh upload
    _detectedClass = data.detected_asset_class || null;
    _detectionConfidence = data.detection_confidence || 0;
    _isOverridden = false;
    showStep2(_detectedClass);
  } catch(e) {
    step1Err.textContent = 'Network error: ' + e.message;
    previewBtn.disabled = false;
    previewBtn.textContent = 'Next: Map Columns';
  }
});

// ── Step 2 setup ──────────────────────────────────────────────────────

let _acListenersAdded = false;

// Column fields per asset class (for mapping diff)
const AC_FIELDS_ALL = {
  stock:   ["date","type","ticker","quantity","price_per_share","total_amount","currency","fx_rate"],
  cfd:     ["date","type","ticker","quantity","price_per_share","total_amount","currency","fx_rate"],
  crypto:  ["date","type","ticker","quantity","price_per_share","total_amount"],
  savings: ["date","type","ticker","quantity","price_per_share","total_amount","fx_rate"],
};

function buildColumnMappingDiff(fromClass, toClass) {
  if (!fromClass || !toClass || fromClass === toClass) return '';
  const from = AC_FIELDS_ALL[fromClass] || [];
  const to   = AC_FIELDS_ALL[toClass]   || [];
  const fromSet = new Set(from);
  const toSet   = new Set(to);
  const removed = from.filter(f => !toSet.has(f));
  const added   = to.filter(f => !fromSet.has(f));
  if (!removed.length && !added.length) return '';
  let html = '<div class="col-diff">';
  removed.forEach(f => {
    html += `<div class="col-diff-row"><span class="col-diff-removed">${esc(FIELD_LABELS[f]||f)}</span><span class="col-diff-arrow">&#10005; removed</span></div>`;
  });
  added.forEach(f => {
    html += `<div class="col-diff-row"><span class="col-diff-to">+ ${esc(FIELD_LABELS[f]||f)}</span><span class="col-diff-arrow">added</span></div>`;
  });
  html += '</div>';
  return html;
}

function updateDetectionBadgeAndWarning() {
  // Show/hide detected badge
  ['stock','cfd','crypto','savings'].forEach(ac => {
    const badge = document.getElementById('badge-' + ac);
    if (badge) badge.style.display = (_detectedClass === ac) ? '' : 'none';
  });

  // Show/hide override warning
  const warn = document.getElementById('overrideWarning');
  if (!warn) return;
  if (_detectedClass && _isOverridden && _assetClass !== _detectedClass) {
    document.getElementById('owSelectedClass').textContent = _assetClass;
    document.getElementById('owDetectedClass').textContent = _detectedClass;
    document.getElementById('overrideDiff').innerHTML = buildColumnMappingDiff(_detectedClass, _assetClass);
    warn.style.display = '';
    announce('Override: you selected ' + _assetClass + ' but we detected ' + _detectedClass);
  } else {
    warn.style.display = 'none';
  }
}

const AC_NAMES = { stock: 'Stock', cfd: 'CFD', crypto: 'Crypto', savings: 'Savings' };

function _setAcRadio(ac) {
  document.querySelectorAll('.ac-btn').forEach(b => {
    const isActive = b.dataset.ac === ac;
    b.classList.toggle('active', isActive);
    b.setAttribute('aria-checked', isActive ? 'true' : 'false');
    b.setAttribute('tabindex', isActive ? '0' : '-1');
  });
}

function showStep2(detectedClass) {
  setStep(2);

  _assetClass = detectedClass || 'stock';
  _isOverridden = false;
  _setAcRadio(_assetClass);

  updateDetectionBadgeAndWarning();

  if (detectedClass) {
    _announceDetect((AC_NAMES[detectedClass] || detectedClass) + ' detected based on your file headers. Use arrow keys to choose a different class.');
  }

  if (!_acListenersAdded) {
    _acListenersAdded = true;
    document.querySelectorAll('.ac-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const prev = _assetClass;
        _assetClass = btn.dataset.ac;
        if (_detectedClass && _assetClass !== _detectedClass) {
          _isOverridden = true;
        } else {
          _isOverridden = false;
        }
        _setAcRadio(_assetClass);
        if (_isOverridden && prev !== _assetClass) {
          _announceOverride((AC_NAMES[_assetClass] || _assetClass) + ' selected. This overrides the detected ' + (AC_NAMES[_detectedClass] || _detectedClass) + ' class.');
        }
        updateDetectionBadgeAndWarning();
        buildMapTable();
        validateStep2();
      });
    });

    // Roving tabindex arrow key navigation (WCAG radiogroup pattern)
    document.getElementById('acToggles').addEventListener('keydown', function(e) {
      const btns = Array.from(this.querySelectorAll('.ac-btn'));
      const currentIdx = btns.indexOf(document.activeElement);
      if (currentIdx === -1) return;
      let nextIdx = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        nextIdx = (currentIdx + 1) % btns.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        nextIdx = (currentIdx - 1 + btns.length) % btns.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        nextIdx = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        nextIdx = btns.length - 1;
      }
      if (nextIdx !== -1) {
        btns[nextIdx].focus();
        btns[nextIdx].click();
      }
    });
  }

  buildPreviewTable();
  buildMapTable();
  validateStep2();
}

function buildPreviewTable() {
  const t = document.getElementById('previewTable');
  let html = '<thead><tr>' + _headers.map(h => {
    const isReviewed = _ciState.reviewedColumns.has(h);
    const reviewMark = isReviewed
      ? '<span class="ci-reviewed-mark" aria-label="Reviewed">✓</span>'
      : '';
    return '<th class="ci-inspectable-th" tabIndex="0"' +
           ' aria-haspopup="dialog"' +
           ' aria-label="Inspect column: ' + esc(h) + '"' +
           ' data-col="' + esc(h) + '">' +
           esc(h) + reviewMark + '</th>';
  }).join('') + '</tr></thead><tbody>';
  _rows.forEach(row => {
    html += '<tr>' + _headers.map((_, i) => '<td>'+esc(row[i] !== undefined ? row[i] : '')+'</td>').join('') + '</tr>';
  });
  t.innerHTML = html + '</tbody>';
  // Wire click and keyboard handlers onto each inspectable header
  t.querySelectorAll('.ci-inspectable-th').forEach(th => {
    th.addEventListener('click', () => openInspector(th.dataset.col, th));
    th.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openInspector(th.dataset.col, th);
      }
    });
  });
}

function bestMatch(field, headers) {
  const aliases = FIELD_ALIASES[field] || [];
  const hLower = headers.map(h => h.toLowerCase().trim());
  for (const alias of aliases) {
    const idx = hLower.indexOf(alias.toLowerCase());
    if (idx !== -1) return headers[idx];
  }
  return '';
}

function buildMapTable() {
  const ac = _assetClass || 'stock';
  const fields = DB_FIELDS[ac];
  const all = [...fields.required, ...fields.optional];
  const t = document.getElementById('mapTable');
  let html = '';
  all.forEach(field => {
    const isReq = fields.required.includes(field);
    const match = bestMatch(field, _headers);
    const opts = ['<option value="">— skip —</option>'].concat(_headers.map(h =>
      `<option value="${esc(h)}" ${h === match ? 'selected' : ''}>${esc(h)}</option>`
    ));
    html += `<tr>
      <td>${FIELD_LABELS[field] || field}</td>
      <td>${isReq ? '<span class="req-badge">Required</span>' : '<span class="opt-badge">Optional</span>'}</td>
      <td><select data-field="${field}" data-req="${isReq ? '1' : '0'}" aria-label="${FIELD_LABELS[field] || field} column mapping">${opts.join('')}</select></td>
    </tr>`;
  });
  t.innerHTML = html;
  t.querySelectorAll('select').forEach(sel => sel.addEventListener('change', validateStep2));
}

function validateStep2() {
  const ac = _assetClass || 'stock';
  const required = DB_FIELDS[ac].required;
  const table = document.getElementById('mapTable');
  let ok = true;
  required.forEach(field => {
    const sel = table.querySelector(`select[data-field="${field}"]`);
    if (!sel || !sel.value) ok = false;
  });
  document.getElementById('nextBtn2').disabled = !ok;
  document.getElementById('step2Err').textContent = '';
}

// ── Step 2 → 3 (Validate) ────────────────────────────────────────────

document.getElementById('nextBtn2').addEventListener('click', () => {
  const ac = _assetClass || 'stock';
  const mappedCount = Object.keys(collectMapping()).length;
  _stepSummaries[2] = ac.charAt(0).toUpperCase() + ac.slice(1) + ', ' + mappedCount + ' column' + (mappedCount === 1 ? '' : 's') + ' mapped';
  showStep3Validate();
});

function collectMapping() {
  const mapping = {};
  document.querySelectorAll('#mapTable select').forEach(sel => {
    if (sel.value) mapping[sel.dataset.field] = sel.value;
  });
  return mapping;
}

// Live progress messages during validation
const VALIDATION_MSGS = [
  'Reading CSV rows...',
  'Checking date formats...',
  'Validating transaction types...',
  'Checking for missing data...',
  'Analysing date gaps...',
  'Almost done...',
];

async function showStep3Validate() {
  setStep(3);

  document.getElementById('validationLoading').style.display = '';
  document.getElementById('validationResults').style.display = 'none';
  document.getElementById('step3Btns').style.display = 'none';
  document.getElementById('step3Err').textContent = '';

  // Cycle progress messages for live feedback
  let msgIdx = 0;
  const progEl = document.getElementById('validationProgressMsg');
  const firstMsg = _rowCount > 0 ? 'Validating ' + _rowCount.toLocaleString() + ' rows...' : VALIDATION_MSGS[0];
  progEl.textContent = firstMsg;
  const progInterval = setInterval(() => {
    msgIdx = (msgIdx + 1) % VALIDATION_MSGS.length;
    progEl.textContent = VALIDATION_MSGS[msgIdx];
  }, 900);

  const mapping = collectMapping();
  try {
    const resp = await fetch('/import/validate', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ asset_class: _assetClass, mapping }),
    });
    clearInterval(progInterval);
    const data = await resp.json();
    if (data.error) {
      document.getElementById('step3Err').textContent = data.error;
      document.getElementById('validationLoading').style.display = 'none';
      document.getElementById('step3Btns').style.display = '';
      return;
    }
    _validationData = data;
    renderValidationResults(data);
  } catch(e) {
    clearInterval(progInterval);
    document.getElementById('step3Err').textContent = 'Network error: ' + e.message;
    document.getElementById('validationLoading').style.display = 'none';
    document.getElementById('step3Btns').style.display = '';
  }
}

function renderValidationResults(data) {
  document.getElementById('validationLoading').style.display = 'none';
  document.getElementById('validationResults').style.display = '';
  document.getElementById('step3Btns').style.display = '';

  const summary = document.getElementById('validationSummary');
  if (data.error_rows === 0 && data.warning_rows === 0) {
    summary.style.background = 'var(--bg-alt, #ecfdf5)';
    summary.style.border = '1px solid var(--green, #34d399)';
    summary.style.color = 'var(--green, #059669)';
    summary.innerHTML = '<strong>&#10003;</strong> ' + esc(data.summary);
    _stepSummaries[3] = data.valid_rows.toLocaleString() + ' rows valid';
  } else if (data.error_rows > 0) {
    summary.style.background = '#fef2f2';
    summary.style.border = '1px solid var(--red, #f87171)';
    summary.style.color = '#991b1b';
    summary.innerHTML = '<strong>&#9888;</strong> ' + esc(data.summary);
    _stepSummaries[3] = data.valid_rows + ' valid, ' + data.error_rows + ' errors';
  } else {
    summary.style.background = '#fff8e1';
    summary.style.border = '1px solid #ffe082';
    summary.style.color = '#6d4c00';
    summary.innerHTML = '<strong>&#9888;</strong> ' + esc(data.summary);
    _stepSummaries[3] = data.valid_rows + ' valid, ' + data.warning_rows + ' warnings';
  }

  const issuesEl = document.getElementById('validationIssues');
  if (data.issues && data.issues.length > 0) {
    const shown = data.issues.slice(0, 50);
    let html = '<div style="font-size:.8rem;font-weight:600;color:var(--muted);margin:.75rem 0 .4rem">Issues (' + data.issues.length + ' total)</div>';
    html += '<div class="validation-issues-list">';
    shown.forEach(issue => {
      const sevClass = issue.severity === 'error' ? 'sev-error' : issue.severity === 'warning' ? 'sev-warning' : 'sev-info';
      const sevLabel = issue.severity === 'error' ? 'ERR' : issue.severity === 'warning' ? 'WARN' : 'INFO';
      html += `<div class="v-issue ${sevClass}">
        <span class="v-sev">${sevLabel}</span>
        <span class="v-row">Row ${issue.row}</span>
        <span class="v-col">${esc(issue.column)}</span>
        <span class="v-msg">${esc(issue.message)}</span>
        ${issue.value ? '<span class="v-val">' + esc(issue.value) + '</span>' : ''}
        ${issue.suggestion ? '<span class="v-sug">' + esc(issue.suggestion) + '</span>' : ''}
      </div>`;
    });
    if (data.issues.length > 50) {
      html += '<div style="font-size:.8rem;color:var(--muted);padding:.4rem">...and ' + (data.issues.length - 50) + ' more issues</div>';
    }
    html += '</div>';
    issuesEl.innerHTML = html;
  } else {
    issuesEl.innerHTML = '';
  }

  const mbEl = document.getElementById('validationMissingBuys');
  if (data.missing_buys && data.missing_buys.length > 0) {
    let html = '<div style="font-size:.8rem;font-weight:600;color:var(--muted);margin:.75rem 0 .4rem">Possible missing data</div>';
    html += '<div style="font-size:.82rem">';
    data.missing_buys.forEach(mb => {
      html += `<div style="padding:.3rem 0;border-bottom:1px solid var(--border,#eee)">
        <strong>${esc(mb.ticker)}</strong>: ${esc(mb.message)}
      </div>`;
    });
    html += '</div>';
    mbEl.innerHTML = html;
  } else {
    mbEl.innerHTML = '';
  }

  const dgEl = document.getElementById('validationDateGaps');
  if (data.date_gaps && data.date_gaps.length > 0) {
    let html = '<div style="font-size:.8rem;font-weight:600;color:var(--muted);margin:.75rem 0 .4rem">Date gaps (&gt;1 year)</div>';
    html += '<div style="font-size:.82rem">';
    data.date_gaps.forEach(g => {
      html += `<div style="padding:.3rem 0;border-bottom:1px solid var(--border,#eee)">
        <strong>${esc(g.ticker)}</strong>: ${g.days} day gap (${esc(g.from)} to ${esc(g.to)})
      </div>`;
    });
    html += '</div>';
    dgEl.innerHTML = html;
  } else {
    dgEl.innerHTML = '';
  }

  const nextBtn = document.getElementById('nextBtn3');
  if (data.error_rows > 0) {
    nextBtn.textContent = 'Import Anyway (' + data.valid_rows + ' valid rows)';
  } else {
    nextBtn.textContent = 'Continue to Import';
  }
}

// ── Step 3 → 4 ────────────────────────────────────────────────────────

