// ── Column Inspector ───────────────────────────────────────────────────────

// State object (ColumnInspectorProvider equivalent)
const _ciState = {
  activeColumn: null,
  reviewedColumns: new Set(),
};

let _ciLastFocused = null;

// Reducer-style dispatch (useReducer equivalent)
function _ciDispatch(action) {
  switch (action.type) {
    case 'OPEN':
      _ciState.activeColumn = action.columnId;
      break;
    case 'CLOSE':
      _ciState.activeColumn = null;
      break;
    case 'MARK_REVIEWED':
      _ciState.reviewedColumns.add(action.columnId);
      _ciState.activeColumn = null;
      break;
  }
  _ciRender();
}

// Public actions
function openInspector(columnId, triggerEl) {
  _ciLastFocused = triggerEl || null;
  _ciDispatch({ type: 'OPEN', columnId });
}

function closeInspector() {
  _ciDispatch({ type: 'CLOSE' });
  if (_ciLastFocused) {
    _ciLastFocused.focus();
    _ciLastFocused = null;
  }
}

function markReviewed(columnId) {
  _ciDispatch({ type: 'MARK_REVIEWED', columnId });
  _ciAnnounce('Reviewed: ' + columnId + ' marked as reviewed');
  if (_ciLastFocused) {
    _ciLastFocused.focus();
    _ciLastFocused = null;
  }
  // Refresh headers to show reviewed checkmark
  if (_headers.length) buildPreviewTable();
}

// Screen reader announcement helper
function _ciAnnounce(msg) {
  const el = document.getElementById('ci-announce');
  if (!el) return;
  el.textContent = '';
  requestAnimationFrame(() => { el.textContent = msg; });
}

// Type emoji helper (📅 date, 💰 currency/price, 🏷️ ticker)
function _ciGetTypeEmoji(fieldName) {
  if (fieldName === 'date') return '📅';
  if (fieldName === 'ticker') return '🏷️';
  if (['price_per_share', 'total_amount', 'fx_rate', 'currency'].includes(fieldName)) return '💰';
  return '';
}

// Transform functions for each field type (live before/after preview)
const _ciTransformFns = {
  date: v => {
    const d = new Date(v);
    return isNaN(d.getTime()) ? v : d.toISOString().slice(0, 10);
  },
  price_per_share: v => {
    const n = parseFloat(v.replace(/[^0-9.\-]/g, ''));
    return isNaN(n) ? v : n.toFixed(2);
  },
  total_amount: v => {
    const n = parseFloat(v.replace(/[^0-9.\-]/g, ''));
    return isNaN(n) ? v : n.toFixed(2);
  },
  fx_rate: v => {
    const n = parseFloat(v.replace(/[^0-9.\-]/g, ''));
    return isNaN(n) ? v : n.toFixed(6);
  },
  currency: v => v.trim().toUpperCase(),
  quantity: v => {
    const n = parseFloat(v.replace(/[^0-9.\-]/g, ''));
    return isNaN(n) ? v : String(n);
  },
};

// Render the inspector panel from current state
function _ciRender() {
  const panel = document.getElementById('columnInspector');
  if (!panel) return;

  if (!_ciState.activeColumn) {
    panel.classList.remove('ci-open');
    panel.setAttribute('aria-hidden', 'true');
    return;
  }

  const colName = _ciState.activeColumn;
  const colIdx = _headers.indexOf(colName);

  // Reverse-lookup: which DB field maps to this CSV column?
  let mappedField = null;
  document.querySelectorAll('#mapTable select').forEach(sel => {
    if (sel.value === colName) mappedField = sel.dataset.field;
  });

  const emoji = mappedField ? _ciGetTypeEmoji(mappedField) : '';
  const fieldLabel = mappedField ? (FIELD_LABELS[mappedField] || mappedField) : 'Unmapped';

  document.getElementById('ci-col-name').textContent = colName;

  const typeBadge = document.getElementById('ci-type-badge');
  typeBadge.textContent = emoji
    ? emoji + ' ' + fieldLabel
    : (mappedField ? fieldLabel : 'Unmapped');

  document.getElementById('ci-mapped-field').textContent = mappedField
    ? 'Mapped to: ' + fieldLabel
    : 'This column is not mapped to any field';

  // Unmapped section: visible only when no mapping
  const unmappedSection = document.getElementById('ci-unmapped-section');
  if (unmappedSection) {
    unmappedSection.style.display = mappedField ? 'none' : '';
  }

  // Sample values — truncate at 50 chars with "Show full" toggle
  const samplesEl = document.getElementById('ci-samples');
  const samples = (_rows || [])
    .map(row => (colIdx >= 0 && row[colIdx] !== undefined ? String(row[colIdx]) : ''))
    .filter(v => v !== '');

  samplesEl.innerHTML = samples.length
    ? '<ul class="ci-sample-list">' +
        samples.slice(0, 10).map(v => {
          if (v.length > 50) {
            return '<li class="ci-sample-item">' +
              esc(v.slice(0, 50)) + '…' +
              ' <button class="ci-show-full" data-full="' + esc(v) + '" aria-label="Show full value">Show full</button>' +
              '</li>';
          }
          return '<li class="ci-sample-item">' + esc(v) + '</li>';
        }).join('') +
      '</ul>'
    : '<div class="ci-no-samples">No sample data available</div>';

  // Transformation preview (Before → After) for mapped fields
  const transformEl = document.getElementById('ci-transform-preview');
  const transformFn = mappedField ? _ciTransformFns[mappedField] : null;
  if (transformFn && samples.length) {
    const previewRows = samples.slice(0, 3).map(v => {
      const transformed = transformFn(v);
      const before = v.length > 50 ? v.slice(0, 50) + '…' : v;
      const after = transformed.length > 50 ? transformed.slice(0, 50) + '…' : transformed;
      return '<div class="ci-transform-row">' +
        '<span class="ci-before">' + esc(before) + '</span>' +
        '<span class="ci-transform-arrow" aria-hidden="true">→</span>' +
        '<span class="ci-after">' + esc(after) + '</span>' +
        '</div>';
    }).join('');
    transformEl.innerHTML =
      '<div class="ci-section-label">Transformation preview</div>' +
      '<div class="ci-transform-rows">' +
        '<div class="ci-transform-hdr"><span>Before</span><span></span><span>After</span></div>' +
        previewRows +
      '</div>';
  } else {
    transformEl.innerHTML = '';
  }

  panel.setAttribute('aria-hidden', 'false');
  panel.classList.add('ci-open');

  // Announce opening to screen readers
  _ciAnnounce('Inspecting column: ' + colName + (mappedField ? ', mapped to ' + fieldLabel : ', Unmapped'));

  // Move focus into panel (focus first button)
  requestAnimationFrame(() => {
    const firstFocusable = panel.querySelector('button:not([disabled])');
    if (firstFocusable) firstFocusable.focus();
  });
}

// Wire action buttons
document.getElementById('ci-looks-good').addEventListener('click', () => {
  if (_ciState.activeColumn) markReviewed(_ciState.activeColumn);
});

document.getElementById('ci-fix-this').addEventListener('click', () => {
  if (_ciState.activeColumn) {
    closeInspector();
    const mapTable = document.getElementById('mapTable');
    if (mapTable) mapTable.scrollIntoView({ behavior: 'smooth', block: 'center' });
