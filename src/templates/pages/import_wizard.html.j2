document.getElementById('ci-change-mapping').addEventListener('click', () => {
  closeInspector();
  const mapTable = document.getElementById('mapTable');
  if (mapTable) mapTable.scrollIntoView({ behavior: 'smooth', block: 'center' });
});

document.getElementById('ci-close').addEventListener('click', closeInspector);

// "Map this column" for unmapped columns — scroll to mapping table
document.getElementById('ci-map-this').addEventListener('click', () => {
  closeInspector();
  const mapTable = document.getElementById('mapTable');
  if (mapTable) mapTable.scrollIntoView({ behavior: 'smooth', block: 'center' });
});

// Event delegation for "Show full" / "Show less" sample value toggles
document.getElementById('ci-samples').addEventListener('click', e => {
  const btn = e.target.closest('.ci-show-full, .ci-show-less');
  if (!btn) return;
  const li = btn.closest('li.ci-sample-item');
  if (!li) return;
  if (btn.classList.contains('ci-show-full')) {
    const full = btn.dataset.full || '';
    li.innerHTML = esc(full) +
      ' <button class="ci-show-less" aria-label="Show less">Show less</button>';
  } else {
    const full = li.textContent.replace('Show less', '').trim();
    const truncated = full.slice(0, 50);
    li.innerHTML = esc(truncated) + '…' +
      ' <button class="ci-show-full" data-full="' + esc(full) + '" aria-label="Show full value">Show full</button>';
  }
});

// Keyboard: Escape closes + focus trap (Tab cycles within panel)
document.addEventListener('keydown', e => {
  const panel = document.getElementById('columnInspector');
  if (!panel) return;
  const isOpen = panel.classList.contains('ci-open');

  if (e.key === 'Escape' && isOpen) {
    closeInspector();
    return;
  }

  if (!isOpen || e.key !== 'Tab') return;

  const focusable = Array.from(
    panel.querySelectorAll('button:not([disabled]), [tabindex]:not([tabindex="-1"])')
  );
  if (focusable.length === 0) return;
  const firstFocusable = focusable[0];
  const lastFocusable = focusable[focusable.length - 1];

  if (e.shiftKey) {
    if (document.activeElement === firstFocusable) {
      e.preventDefault();
      lastFocusable.focus();
    }
  } else {
    if (document.activeElement === lastFocusable) {
      e.preventDefault();
      firstFocusable.focus();
    }
  }
});

// Click-outside: clicking the table area behind the drawer closes it
document.addEventListener('click', e => {
  const panel = document.getElementById('columnInspector');
  if (!panel || !panel.classList.contains('ci-open')) return;
  if (!panel.contains(e.target) && !e.target.closest('.ci-inspectable-th')) {
    closeInspector();
  }
});
</script>
{% endblock %}
