{% extends "base.html.j2" %}

{% block meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block title %}Transactions — WealthEagle{% endblock %}

{% block extra_css %}
<style>
.tx-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;flex-wrap:wrap;gap:.75rem}
.tx-header h1{font-size:1.2rem;font-weight:700;margin:0}
.tx-filters{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1rem;align-items:flex-end}
.tx-filters input,.tx-filters select{padding:.4rem .6rem;border:1px solid var(--border);border-radius:6px;font-size:.85rem;background:var(--card-bg);color:var(--text);font-family:inherit}
.tx-filters input[type=text]{width:140px}
.tx-filters input[type=date]{width:140px}
.tx-filters .filter-label{font-size:.75rem;color:var(--text-muted);font-weight:500;align-self:center}
.tx-filters select{width:130px}
.btn-sm{padding:.35rem .75rem;font-size:.8rem;border-radius:6px;border:none;cursor:pointer;font-weight:500}
.btn-primary{background:var(--accent,#4f46e5);color:#fff}
.btn-primary:hover{opacity:.88}
.btn-secondary{background:var(--bg-secondary,#f3f4f6);color:var(--text);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--hover-bg,#e5e7eb)}
.btn-danger{background:#dc2626;color:#fff}
.btn-danger:hover{opacity:.88}

/* Table */
.tx-table-wrap{overflow-x:auto}
.tx-table{width:100%;border-collapse:collapse;font-size:.85rem}
.tx-table th{text-align:left;padding:.5rem .6rem;border-bottom:2px solid var(--border);font-weight:600;white-space:nowrap;color:var(--muted)}
.tx-table td{padding:.45rem .6rem;border-bottom:1px solid var(--border);vertical-align:middle;white-space:nowrap}
.tx-table tr:hover td{background:var(--hover-bg,rgba(0,0,0,.03))}
.source-icon{display:inline-flex;align-items:center;opacity:.7}
.type-badge{display:inline-block;padding:2px 7px;border-radius:4px;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.02em}
.type-buy{background:#d1fae5;color:#065f46}
.type-sell{background:#fee2e2;color:#991b1b}
.type-dividend{background:#dbeafe;color:#1e40af}
.type-other{background:#f3f4f6;color:#4b5563}
.ac-badge{font-size:.72rem;padding:2px 6px;border-radius:4px;background:var(--chip-bg,#e5e7eb);color:var(--chip-text,#374151)}
.tx-actions{display:flex;gap:.3rem}
.btn-row{padding:3px 8px;font-size:.75rem;border-radius:4px;border:1px solid var(--border);cursor:pointer;background:var(--card-bg);color:var(--text)}
.btn-row:hover{background:var(--hover-bg)}
.btn-row-danger{color:#dc2626;border-color:#fca5a5}
.btn-row-danger:hover{background:#fee2e2}

/* Pagination */
.tx-pagination{display:flex;align-items:center;gap:.5rem;margin-top:1rem;font-size:.85rem;justify-content:flex-end;flex-wrap:wrap}
.tx-pagination button{padding:.3rem .65rem;border:1px solid var(--border);border-radius:5px;cursor:pointer;background:var(--card-bg);color:var(--text)}
.tx-pagination button:disabled{opacity:.4;cursor:default}
.tx-pagination button.active{background:var(--accent,#4f46e5);color:#fff;border-color:transparent}
.tx-page-info{color:var(--muted)}
.empty-state{text-align:center;padding:3rem 1rem;color:var(--muted)}

/* Modal overlay */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:1000;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.modal-overlay.active{display:flex}
.modal-box{background:var(--card-bg);border-radius:10px;padding:1.5rem;max-width:520px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.5);max-height:90vh;overflow-y:auto;border:1px solid var(--border)}
.modal-title{font-size:1.05rem;font-weight:700;margin:0 0 1.1rem 0}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem}
.form-row.full{grid-template-columns:1fr}
.form-group{display:flex;flex-direction:column;gap:.25rem}
.form-group label{font-size:.8rem;font-weight:500;color:var(--muted)}
.form-group input,.form-group select{padding:.5rem .6rem;border:1px solid var(--border);border-radius:6px;font-size:.88rem;background:var(--card-bg);color:var(--text);font-family:inherit;width:100%;box-sizing:border-box}
.form-group input:focus,.form-group select:focus{outline:2px solid var(--accent,#4f46e5);outline-offset:1px}
.field-error{font-size:.75rem;color:#dc2626;margin-top:2px}
.modal-actions{display:flex;gap:.75rem;justify-content:flex-end;margin-top:1.25rem}

/* Delete modal */
.del-modal-box{background:var(--card-bg);border-radius:10px;padding:1.5rem;max-width:360px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.del-modal-title{font-size:1.05rem;font-weight:700;margin:0 0 .5rem 0}
.del-modal-body{font-size:.88rem;color:var(--muted);margin-bottom:1.25rem}

/* Toast */
.toast{position:fixed;bottom:1.5rem;right:1.5rem;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;padding:.75rem 1rem;font-size:.88rem;box-shadow:0 4px 12px rgba(0,0,0,.15);z-index:2000;display:none}
.toast.show{display:flex;align-items:center;gap:.5rem}
.toast-success{border-color:#10b981;color:#065f46}
.toast-error{border-color:#dc2626;color:#dc2626}

@media(max-width:600px){
  .form-row{grid-template-columns:1fr}
  .tx-filters input,.tx-filters select{width:100%}
}
</style>
{% endblock %}

{% block content %}
<div class="app-main">
  <div class="tx-header">
    <h1>Transactions</h1>
    {% if role in ("premium", "admin") %}
    <button class="btn-sm btn-primary" onclick="openAddModal()">+ Add Transaction</button>
    {% endif %}
  </div>

  <!-- Filters -->
  <div class="tx-filters">
    <input type="text" id="filterTicker" placeholder="Ticker…" oninput="debouncedLoad()" style="text-transform:uppercase">
    <select id="filterAssetClass" onchange="loadPage(1)">
      <option value="">All classes</option>
      <option value="stock">Stocks</option>
      <option value="cfd">CFD</option>
      <option value="crypto">Crypto</option>
      <option value="savings">Savings</option>
    </select>
    <select id="filterType" onchange="loadPage(1)">
      <option value="">All types</option>
      <option value="BUY">BUY</option>
      <option value="SELL">SELL</option>
      <option value="DIVIDEND">DIVIDEND</option>
      <option value="STOCK SPLIT">STOCK SPLIT</option>
      <option value="Staking reward">Staking reward</option>
      <option value="Interest PAID">Interest PAID</option>
    </select>
    <label class="filter-label" for="filterFrom">From</label>
    <input type="date" id="filterFrom" onchange="loadPage(1)" title="Date from">
    <label class="filter-label" for="filterTo">To</label>
    <input type="date" id="filterTo" onchange="loadPage(1)" title="Date to">
    <button class="btn-sm btn-secondary" onclick="clearFilters()">Clear</button>
  </div>

  <!-- Table -->
  <div class="tx-table-wrap" id="txTableWrap">
    <table class="tx-table" id="txTable">
      <thead>
        <tr>
          <th>Date</th>
          <th>Ticker</th>
          <th>Type</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Total</th>
          <th>Currency</th>
          <th>Asset Class</th>
          <th>Source</th>
          {% if role in ("premium", "admin") %}<th></th>{% endif %}
        </tr>
      </thead>
      <tbody id="txBody">
        <tr><td colspan="10" class="empty-state" id="txLoading">Loading…</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="tx-pagination" id="txPagination"></div>
</div>

<!-- Add / Edit modal -->
<div class="modal-overlay" id="txModal" role="dialog" aria-modal="true" aria-labelledby="txModalTitle">
  <div class="modal-box">
    <div class="modal-title" id="txModalTitle">Add Transaction</div>
    <form id="txForm" novalidate>
      <input type="hidden" id="txId">
      <div class="form-row">
        <div class="form-group">
          <label for="fDate">Date *</label>
          <input type="date" id="fDate" required>
          <span class="field-error" id="errDate"></span>
        </div>
        <div class="form-group">
          <label for="fAssetClass">Asset Class *</label>
          <select id="fAssetClass" required onchange="updateTypeOptions()">
            <option value="">Select…</option>
            <option value="stock">Stock</option>
            <option value="cfd">CFD</option>
            <option value="crypto">Crypto</option>
            <option value="savings">Savings</option>
          </select>
          <span class="field-error" id="errAssetClass"></span>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="fTicker">Ticker *</label>
          <input type="text" id="fTicker" placeholder="e.g. AAPL" style="text-transform:uppercase" required>
          <span class="field-error" id="errTicker"></span>
        </div>
        <div class="form-group">
          <label for="fType">Type *</label>
          <select id="fType" required>
            <option value="">Select asset class first</option>
          </select>
          <span class="field-error" id="errType"></span>
        </div>
      </div>
      <div class="form-row" id="qtyPriceRow">
        <div class="form-group">
          <label for="fQty">Quantity</label>
          <input type="number" id="fQty" step="any" min="0" placeholder="0">
          <span class="field-error" id="errQuantity"></span>
        </div>
        <div class="form-group">
          <label for="fPrice">Price per Share</label>
          <input type="number" id="fPrice" step="any" min="0" placeholder="0.00">
          <span class="field-error" id="errPrice_per_share"></span>
        </div>
      </div>
      <div class="form-row full" id="splitRatioRow" style="display:none">
        <div class="form-group">
          <label for="fSplitRatio">Split Ratio *</label>
          <input type="text" id="fSplitRatio" placeholder="e.g. 4:1">
          <span class="field-error" id="errSplit_ratio"></span>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="fCurrency">Currency</label>
          <input type="text" id="fCurrency" value="EUR" maxlength="3" style="text-transform:uppercase" oninput="onCurrencyChange()">
          <span class="field-error" id="errCurrency"></span>
        </div>
        <div class="form-group">
          <label for="fFx">FX Rate <span id="fxLabel" style="color:var(--muted);font-size:.72rem">(EUR rate)</span></label>
          <input type="number" id="fFx" step="any" min="0" placeholder="1.0">
          <span class="field-error" id="errFx_rate"></span>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="fCommission">Commission</label>
          <input type="number" id="fCommission" step="any" min="0" placeholder="0.00">
          <span class="field-error" id="errCommission"></span>
        </div>
        <div class="form-group">
          <label for="fWht">Withholding Tax</label>
          <input type="number" id="fWht" step="any" min="0" placeholder="0.00">
          <span class="field-error" id="errWithholding_tax"></span>
        </div>
      </div>
      <div id="txFormError" style="color:#dc2626;font-size:.83rem;margin-bottom:.5rem;display:none"></div>
      <div class="modal-actions">
        <button type="button" class="btn-sm btn-secondary" onclick="closeModal()">Cancel</button>
        <button type="submit" class="btn-sm btn-primary" id="txSubmitBtn">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal-overlay" id="delModal" role="dialog" aria-modal="true" aria-labelledby="delModalTitle">
  <div class="del-modal-box">
    <div class="del-modal-title" id="delModalTitle">Delete transaction?</div>
    <div class="del-modal-body" id="delModalBody">This cannot be undone.</div>
    <div class="modal-actions">
      <button class="btn-sm btn-secondary" onclick="closeDelModal()">Cancel</button>
      <button class="btn-sm btn-danger" id="delConfirmBtn" onclick="confirmDelete()">Delete</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast" role="alert"></div>
{% endblock %}

{% block extra_js %}
<script>
var _currentPage = 1;
var _totalPages = 1;
var _debounceTimer = null;
var _deleteId = null;
var _isEditing = false;

var TYPE_OPTIONS = {
  stock:   ['BUY','SELL','DIVIDEND','STOCK SPLIT'],
  cfd:     ['BUY','SELL'],
  crypto:  ['BUY','SELL','Staking reward'],
  savings: ['BUY','SELL','Interest PAID']
};

// ------ filters ------
function getFilters() {
  return {
    ticker:      document.getElementById('filterTicker').value.trim(),
    asset_class: document.getElementById('filterAssetClass').value,
    type:        document.getElementById('filterType').value,
    date_from:   document.getElementById('filterFrom').value,
    date_to:     document.getElementById('filterTo').value,
  };
}

function clearFilters() {
  document.getElementById('filterTicker').value = '';
  document.getElementById('filterAssetClass').value = '';
  document.getElementById('filterType').value = '';
  document.getElementById('filterFrom').value = '';
  document.getElementById('filterTo').value = '';
  loadPage(1);
}

function debouncedLoad() {
  clearTimeout(_debounceTimer);
  _debounceTimer = setTimeout(function(){ loadPage(1); }, 350);
}

// ------ load table ------
function loadPage(page) {
  _currentPage = page;
  var f = getFilters();
  var qs = 'page=' + page + '&per_page=50';
  if (f.ticker)      qs += '&ticker='      + encodeURIComponent(f.ticker.toUpperCase());
  if (f.asset_class) qs += '&asset_class=' + encodeURIComponent(f.asset_class);
  if (f.type)        qs += '&type='        + encodeURIComponent(f.type);
  if (f.date_from)   qs += '&date_from='   + encodeURIComponent(f.date_from);
  if (f.date_to)     qs += '&date_to='     + encodeURIComponent(f.date_to);

  var tbody = document.getElementById('txBody');
  tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:2rem;color:var(--muted)">Loading…</td></tr>';

  fetch('/api/transactions?' + qs)
    .then(function(r){ return r.json(); })
    .then(function(data){
      _totalPages = data.pages || 1;
      renderTable(data.transactions || [], data.total || 0);
      renderPagination(data.page, data.pages, data.total);
    })
    .catch(function(){ tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:#dc2626;padding:2rem">Failed to load transactions.</td></tr>'; });
}

function fmtNum(v, dec) {
  if (v == null) return '—';
  return (+v).toLocaleString('en', {minimumFractionDigits:dec||0, maximumFractionDigits:dec||4});
}

function typeBadgeClass(t) {
  if (!t) return 'type-other';
  var u = t.toUpperCase();
  if (u === 'BUY') return 'type-buy';
  if (u === 'SELL') return 'type-sell';
  if (u === 'DIVIDEND' || u === 'INTEREST PAID') return 'type-dividend';
  return 'type-other';
}

function sourceIcon(src) {
  if (src === 'manual') {
    return '<span class="source-icon" title="Manual entry"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>';
  }
  return '<span class="source-icon" title="Imported"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></span>';
}

var _isPremium = {{ 'true' if role in ('premium', 'admin') else 'false' }};

function renderTable(rows, total) {
  var tbody = document.getElementById('txBody');
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="10"><div class="empty-state">No transactions found.</div></td></tr>';
    return;
  }
  var html = '';
  rows.forEach(function(r) {
    var actionsHtml = '';
    if (_isPremium && r.broker_source === 'manual') {
      actionsHtml = '<div class="tx-actions">' +
        '<button class="btn-row" onclick="openEditModal(' + JSON.stringify(r).replace(/</g,'\\u003c') + ')">Edit</button>' +
        '<button class="btn-row btn-row-danger" onclick="openDelModal(' + r.id + ',\'' + (r.ticker||'').replace(/'/g,"\\'") + '\',\'' + r.date + '\')">Delete</button>' +
        '</div>';
    } else if (_isPremium) {
      actionsHtml = '<div class="tx-actions"></div>';
    }
    html += '<tr>' +
      '<td>' + (r.date||'') + '</td>' +
      '<td style="font-family:monospace;font-weight:600">' + (r.ticker||'') + '</td>' +
      '<td><span class="type-badge ' + typeBadgeClass(r.type) + '">' + (r.type||'') + '</span></td>' +
      '<td>' + (r.quantity != null ? fmtNum(r.quantity, 4) : '—') + '</td>' +
      '<td>' + (r.price_per_share != null ? fmtNum(r.price_per_share, 4) : '—') + '</td>' +
      '<td>' + (r.total_amount != null ? fmtNum(r.total_amount, 2) : '—') + '</td>' +
      '<td>' + (r.currency||'') + '</td>' +
      '<td><span class="ac-badge">' + (r.asset_class||'') + '</span></td>' +
      '<td>' + sourceIcon(r.broker_source) + '</td>' +
      (actionsHtml ? '<td>' + actionsHtml + '</td>' : '') +
      '</tr>';
  });
  tbody.innerHTML = html;
}

function renderPagination(page, pages, total) {
  var el = document.getElementById('txPagination');
  if (!pages || pages <= 1) { el.innerHTML = '<span class="tx-page-info">' + total + ' transaction' + (total===1?'':'s') + '</span>'; return; }
  var html = '<span class="tx-page-info">' + total + ' transactions · page ' + page + ' of ' + pages + '</span>';
  html += '<button onclick="loadPage(' + (page-1) + ')"' + (page<=1?' disabled':'') + '>‹ Prev</button>';
  var start = Math.max(1, page-2), end = Math.min(pages, page+2);
  for (var p=start; p<=end; p++) {
    html += '<button onclick="loadPage(' + p + ')"' + (p===page?' class="active"':'') + '>' + p + '</button>';
  }
  html += '<button onclick="loadPage(' + (page+1) + ')"' + (page>=pages?' disabled':'') + '>Next ›</button>';
  el.innerHTML = html;
}

// ------ Add/Edit modal ------
function _isSplitType() {
  return document.getElementById('fType').value === 'STOCK SPLIT';
}

function _updateSplitVisibility() {
  var isSplit = _isSplitType();
  document.getElementById('qtyPriceRow').style.display = isSplit ? 'none' : '';
  document.getElementById('splitRatioRow').style.display = isSplit ? '' : 'none';
}

function updateTypeOptions(preset) {
  var ac = document.getElementById('fAssetClass').value;
  var sel = document.getElementById('fType');
  var opts = TYPE_OPTIONS[ac] || [];
  sel.innerHTML = '<option value="">Select…</option>';
  opts.forEach(function(t){
    var o = document.createElement('option');
    o.value = t; o.textContent = t;
    if (preset && t === preset) o.selected = true;
    sel.appendChild(o);
  });
  _updateSplitVisibility();
}

document.getElementById('fType').addEventListener('change', _updateSplitVisibility);

function onCurrencyChange() {
  var cur = document.getElementById('fCurrency').value.trim().toUpperCase();
  var label = document.getElementById('fxLabel');
  label.textContent = cur && cur !== 'EUR' ? '(required for non-EUR)' : '(EUR rate)';
}

function openAddModal() {
  _isEditing = false;
  document.getElementById('txId').value = '';
  document.getElementById('txModalTitle').textContent = 'Add Transaction';
  document.getElementById('txSubmitBtn').textContent = 'Add';
  document.getElementById('txForm').reset();
  clearFieldErrors();
  document.getElementById('fCurrency').value = 'EUR';
  document.getElementById('fFx').value = '';
  document.getElementById('fSplitRatio').value = '';
  updateTypeOptions();
  document.getElementById('txModal').classList.add('active');
  document.getElementById('fDate').focus();
}

function openEditModal(row) {
  _isEditing = true;
  document.getElementById('txId').value = row.id;
  document.getElementById('txModalTitle').textContent = 'Edit Transaction';
  document.getElementById('txSubmitBtn').textContent = 'Save';
  clearFieldErrors();

  document.getElementById('fDate').value = row.date || '';
  document.getElementById('fAssetClass').value = row.asset_class || '';
  document.getElementById('fTicker').value = row.ticker || '';
  updateTypeOptions(row.type);
  document.getElementById('fType').value = row.type || '';
  var isSplit = row.type === 'STOCK SPLIT';
  document.getElementById('fQty').value = (!isSplit && row.quantity != null) ? row.quantity : '';
  document.getElementById('fPrice').value = (!isSplit && row.price_per_share != null) ? row.price_per_share : '';
  // For STOCK SPLIT, price_per_share stores the ratio for round-trip editing
  document.getElementById('fSplitRatio').value = isSplit && row.price_per_share != null ? row.price_per_share : '';
  document.getElementById('fCurrency').value = row.currency || 'EUR';
  document.getElementById('fFx').value = row.fx_rate != null ? row.fx_rate : '';
  document.getElementById('fCommission').value = row.commission != null ? row.commission : '';
  document.getElementById('fWht').value = row.withholding_tax != null ? row.withholding_tax : '';
  onCurrencyChange();
  document.getElementById('txModal').classList.add('active');
  document.getElementById('fDate').focus();
}

function closeModal() {
  document.getElementById('txModal').classList.remove('active');
}

function clearFieldErrors() {
  ['Date','AssetClass','Ticker','Type','Quantity','Price_per_share','Currency','Fx_rate','Commission','Withholding_tax','Split_ratio'].forEach(function(f){
    var el = document.getElementById('err' + f);
    if (el) el.textContent = '';
  });
  var fe = document.getElementById('txFormError');
  fe.style.display = 'none'; fe.textContent = '';
}

document.getElementById('txForm').addEventListener('submit', function(e){
  e.preventDefault();
  clearFieldErrors();
  var id = document.getElementById('txId').value;
  var txType = document.getElementById('fType').value;
  var isSplit = txType === 'STOCK SPLIT';
  var payload = {
    date:            document.getElementById('fDate').value,
    asset_class:     document.getElementById('fAssetClass').value,
    ticker:          document.getElementById('fTicker').value.trim().toUpperCase(),
    type:            txType,
    currency:        document.getElementById('fCurrency').value.trim().toUpperCase() || 'EUR',
    fx_rate:         document.getElementById('fFx').value || null,
    commission:      document.getElementById('fCommission').value || null,
    withholding_tax: document.getElementById('fWht').value || null,
  };
  if (isSplit) {
    payload.split_ratio = document.getElementById('fSplitRatio').value || null;
  } else {
    payload.quantity        = document.getElementById('fQty').value || null;
    payload.price_per_share = document.getElementById('fPrice').value || null;
  }

  var url = id ? '/api/transactions/' + id : '/api/transactions';
  var method = id ? 'PUT' : 'POST';
  var btn = document.getElementById('txSubmitBtn');
  btn.disabled = true;

  fetch(url, {method:method, headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)})
    .then(function(r){ return r.json().then(function(d){ return {ok:r.ok, status:r.status, data:d}; }); })
    .then(function(res){
      if (res.ok) {
        closeModal();
        loadPage(_currentPage);
        showToast(id ? 'Transaction updated' : 'Transaction added', 'success');
      } else if (res.status === 422 && res.data.fields) {
        var fields = res.data.fields;
        Object.keys(fields).forEach(function(k){
          var key = k.charAt(0).toUpperCase() + k.slice(1);
          var el = document.getElementById('err' + key);
          if (el) { el.textContent = fields[k]; }
        });
      } else {
        var fe = document.getElementById('txFormError');
        fe.textContent = res.data.error || 'Error saving transaction';
        fe.style.display = 'block';
      }
    })
    .catch(function(){ showToast('Network error', 'error'); })
    .finally(function(){ btn.disabled = false; });
});

// ------ Delete modal ------
function openDelModal(id, ticker, date) {
  _deleteId = id;
  document.getElementById('delModalBody').textContent =
    'Delete ' + (ticker||'transaction') + ' on ' + date + '? This cannot be undone.';
  document.getElementById('delModal').classList.add('active');
  document.getElementById('delConfirmBtn').focus();
}

function closeDelModal() {
  document.getElementById('delModal').classList.remove('active');
  _deleteId = null;
}

function confirmDelete() {
  if (!_deleteId) return;
  var btn = document.getElementById('delConfirmBtn');
  btn.disabled = true;
  fetch('/api/transactions/' + _deleteId, {method:'DELETE'})
    .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,data:d}; }); })
    .then(function(res){
      closeDelModal();
      if (res.ok) {
        loadPage(_currentPage);
        showToast('Transaction deleted', 'success');
      } else {
        showToast(res.data.error || 'Delete failed', 'error');
      }
    })
    .catch(function(){ showToast('Network error', 'error'); })
    .finally(function(){ btn.disabled = false; btn.textContent = 'Delete'; });
}

// ------ keyboard traps & escape ------
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') {
    if (document.getElementById('txModal').classList.contains('active')) closeModal();
    if (document.getElementById('delModal').classList.contains('active')) closeDelModal();
  }
});

// ------ toast ------
function showToast(msg, type) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show toast-' + (type||'success');
  setTimeout(function(){ t.className = 'toast'; }, 4000);
}

// Initial load
loadPage(1);
</script>
{% endblock %}
