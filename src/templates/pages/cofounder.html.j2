{% extends "base.html.j2" %}

{% block title %}Become a Co-Founder — WealthEagle{% endblock %}

{% block extra_css %}
<style>
.cofounder-page {
  max-width: 600px;
  width: 100%;
  margin: 0 auto;
  padding: 2.5rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.cofounder-hero {
  text-align: center;
}

.cofounder-hero h1 {
  font-size: clamp(1.4rem, 3.5vw, 2rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  margin-bottom: 0.5rem;
}

.cofounder-hero p {
  font-size: 0.95rem;
  color: var(--muted);
  line-height: 1.6;
}

.cofounder-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.cofounder-price {
  text-align: center;
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--border);
}

.cofounder-price .amount {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--accent);
}

.cofounder-price .currency {
  font-size: 1rem;
  color: var(--muted);
}

.cofounder-price .period {
  font-size: 0.85rem;
  color: var(--muted);
  margin-top: 0.25rem;
}

.cofounder-features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.cofounder-features li {
  font-size: 0.9rem;
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

.cofounder-features .check {
  color: var(--green);
  font-weight: 700;
  flex-shrink: 0;
}

.cofounder-actions {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.checkout-btn {
  padding: 0.8rem 1.5rem;
  font-size: 1rem;
  width: 100%;
  text-align: center;
  cursor: pointer;
  background: var(--accent);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  font-weight: 600;
  transition: background 0.2s;
}

.checkout-btn:hover {
  background: var(--accent-dark);
}

.checkout-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-back {
  padding: 0.6rem 1rem;
  font-size: 0.9rem;
  text-align: center;
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-weight: 500;
  transition: background 0.2s;
}

.btn-back:hover {
  background: var(--raised);
}

.loading-spinner {
  display: inline-block;
  width: 1rem;
  height: 1rem;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: white;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 768px) {
  .cofounder-page {
    padding: 1.5rem 0.75rem;
    gap: 1.5rem;
  }

  .cofounder-card {
    padding: 1.5rem;
  }

  .cofounder-price .amount {
    font-size: 2rem;
  }
}
</style>
{% endblock %}

{% block content %}
<div class="cofounder-page">
  <section class="cofounder-hero">
    <h1>Become a Co-Founder</h1>
    <p>Get unlimited tickets, credits, and exclusive features. One-time payment, lifetime access.</p>
  </section>

  <div class="cofounder-card">
    <div class="cofounder-price">
      <div class="amount"><span class="currency">€</span>{{ price_eur }}</div>
      <div class="period">One-time payment</div>
    </div>

    <ul class="cofounder-features">
      <li><span class="check">✓</span> Unlimited tickets & feature requests</li>
      <li><span class="check">✓</span> 100 weekly credits (reset every Monday)</li>
      <li><span class="check">✓</span> Priority support & feature voting</li>
      <li><span class="check">✓</span> All premium portfolio analytics</li>
      <li><span class="check">✓</span> Advanced tax reporting</li>
    </ul>

    <div class="cofounder-actions">
      <button id="checkoutBtn" class="checkout-btn" onclick="handleCheckout()">
        Start Co-Founder Checkout
      </button>
      <a href="/" class="btn-back">Back to Dashboard</a>
    </div>
  </div>
</div>

<script>
async function handleCheckout() {
  const btn = document.getElementById('checkoutBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="loading-spinner"></span> Processing...';

  try {
    const response = await fetch('/cofounder/checkout', { method: 'POST' });
    const data = await response.json();

    if (data.checkout_url) {
      window.location.href = data.checkout_url;
    } else {
      alert('Error: ' + (data.error || 'Failed to start checkout'));
      btn.disabled = false;
      btn.innerHTML = 'Start Co-Founder Checkout';
    }
  } catch (error) {
    alert('Error: ' + error.message);
    btn.disabled = false;
    btn.innerHTML = 'Start Co-Founder Checkout';
  }
}
</script>
{% endblock %}
