<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Interactive portfolio report with performance charts, tax overview, and FIRE projections — powered by WealthEagle.">
<meta name="robots" content="index, follow">
<meta property="og:title" content="Portfolio Report — WealthEagle">
<meta property="og:description" content="Interactive portfolio report with performance charts, tax overview, and FIRE projections.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="WealthEagle">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Portfolio Report — WealthEagle">
<meta name="twitter:description" content="Interactive portfolio report with performance charts, tax overview, and FIRE projections.">
<!-- Apply saved theme before paint to avoid flash -->
<script>(function(){var t=localStorage.getItem('theme');if(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme:light)').matches)t='light';if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
<title>Portfolio Report — WealthEagle</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2"></script>
<script src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>
<style>
{% include "assets/styles.css" %}
{% include "assets/styles_notes.css" %}
</style>
</head>
<body>
{% include "sections/quick_glance.html.j2" %}
<div class="layout">

  {% include "sections/header.html.j2" %}

  <main class="content">
    <div class="page-filters" id="pageFilters" style="display:none">
      <select id="mobileRegimeSelect" class="regime-select"></select>
      <div id="mobileAssetToggles" class="page-filters-toggles"></div>
    </div>
    <div class="page active" id="page-overview">
      {% include "sections/summary.html.j2" %}
    </div>
    <div class="page" id="page-charts">
      {% include "sections/charts.html.j2" %}
    </div>
    <div class="page" id="page-positions">
      {% include "sections/positions.html.j2" %}
    </div>
    <div class="page" id="page-dividends">
      {% include "sections/dividends.html.j2" %}
    </div>
    <div class="page" id="page-projections">
      {% include "sections/projections.html.j2" %}
    </div>
    <div class="page" id="page-notes">
      {% include "sections/notes.html.j2" %}
    </div>
    <div class="page" id="page-realestate">
      {% include "sections/real_estate.html.j2" %}
    </div>
    <div class="page" id="page-risk">
      {% include "sections/risk.html.j2" %}
    </div>
    <div class="page" id="page-dca">
      {% include "sections/dca_strategy.html.j2" %}
    </div>
    <div class="page" id="page-tax">
      <div class="tax-subtabs" id="taxSubtabs">
        <button class="tax-subtab active" data-subtab="summary">Summary</button>
        <button class="tax-subtab" data-subtab="smart-sell">Smart Sell</button>
        <button class="tax-subtab" data-subtab="file">File</button>
      </div>
      <div class="tax-subtab-content" id="taxSubtabSummary" data-subtab-panel="summary">
        {% include "sections/tax_timeline.html.j2" %}
        {% include "sections/tax_preview.html.j2" %}
        {% include "sections/holding_countdown.html.j2" %}
        {% include "sections/tax.html.j2" %}
      </div>
      <div class="tax-subtab-content" id="taxSubtabSmartSell" data-subtab-panel="smart-sell" style="display:none">
        {% include "sections/smart_sell.html.j2" %}
      </div>
      <div class="tax-subtab-content" id="taxSubtabFile" data-subtab-panel="file" style="display:none">
        {% include "sections/tax_wizard.html.j2" %}
      </div>
    </div>
    <div class="page" id="page-history">
      {% include "sections/transactions.html.j2" %}
    </div>
  </main>

</div>

{% include "sections/share_modal.html.j2" %}

<script>const D={{ data_json }};</script>
<script>
{% include "assets/app.js" %}
{% include "assets/tooltips.js" %}
{% include "assets/filter.js" %}
{% include "assets/share.js" %}
{% include "assets/charts.js" %}
{% include "assets/heatmap.js" %}
{% include "assets/tables.js" %}
{% include "assets/sections/summary.js" %}
{% include "assets/sections/gains.js" %}
{% include "assets/sections/positions.js" %}
{% include "assets/sections/dividends.js" %}
{% include "assets/sections/benchmark_table.js" %}
{% include "assets/sections/whatif.js" %}
{% include "assets/sections/tax.js" %}
{% include "assets/sections/dividend_tax.js" %}
{% include "assets/sections/tax_timeline.js" %}
{% include "assets/sections/tax_preview.js" %}
{% include "assets/sections/holding_countdown.js" %}
{% include "assets/sections/tax_wizard.js" %}
{% include "assets/sections/smart_sell.js" %}
{% include "assets/sections/transactions.js" %}
{% include "assets/sections/real_estate.js" %}
{% include "assets/sections/notes.js" %}
{% include "assets/sections/risk.js" %}
{% include "assets/sections/dca_strategy.js" %}
{% include "assets/sections/monte_carlo.js" %}
{% include "assets/sections/quick_glance.js" %}
{% include "assets/nav.js" %}
{% include "assets/layout.js" %}
{% include "assets/notifications.js" %}
{% include "assets/achievements.js" %}
{% include "assets/onboarding.js" %}

// --- Initial render ---
// Charts are on the overview page (active by default), so they size correctly without tricks
portfolioChart = buildPortfolioChart();
benchmarkChart = buildBenchmarkChart();
updateAll();
buildHeatmap();
buildDrawdownChart();
buildYearlyHeatmap();
buildYearlyTable();
buildRollingReturns();
</script>
</body>
</html>
