<body>
{% include "sections/quick_glance.html.j2" %}
<div class="layout">

  {% include "sections/header.html.j2" %}

  <main class="content">
    <div class="page-filters" id="pageFilters" style="display:none">
      <select id="mobileRegimeSelect" class="regime-select"></select>
      <div id="mobileAssetToggles" class="page-filters-toggles"></div>
    </div>
    <div class="page" id="page-dashboard">
      {% include "sections/dashboard.html.j2" %}
    </div>
    <div class="page active" id="page-overview">
      {% include "sections/summary.html.j2" %}
    </div>
    <div class="page" id="page-charts">
      {% include "sections/charts.html.j2" %}
    </div>
    <div class="page" id="page-positions">
      {% include "sections/positions.html.j2" %}
    </div>
    <div class="page" id="page-dividends">
      {% include "sections/dividends.html.j2" %}
    </div>
    <div class="page" id="page-projections">
      {% include "sections/projections.html.j2" %}
    </div>
    <div class="page" id="page-notes">
      {% include "sections/notes.html.j2" %}
    </div>
    <div class="page" id="page-realestate">
      {% include "sections/real_estate.html.j2" %}
    </div>
    <div class="page" id="page-risk">
      {% include "sections/risk.html.j2" %}
    </div>
    <div class="page" id="page-dca">
      {% include "sections/dca_strategy.html.j2" %}
    </div>
    <div class="page" id="page-tax">
      <div class="tax-subtabs" id="taxSubtabs">
        <button class="tax-subtab active" data-subtab="summary">Summary</button>
        <button class="tax-subtab" data-subtab="advanced">Advanced</button>
      </div>
      <div class="tax-subtab-content" id="taxSubtabSummary" data-subtab-panel="summary">
        {% include "sections/tax_metrics_summary.html.j2" %}
        {% include "sections/tax.html.j2" %}
      </div>
      <div class="tax-subtab-content" id="taxSubtabAdvanced" data-subtab-panel="advanced" style="display:none">
        {% include "sections/tax_advanced.html.j2" %}
      </div>
    </div>
    <div class="page" id="page-history">
      {% include "sections/transactions.html.j2" %}
    </div>
  </main>

</div>

{% include "sections/share_modal.html.j2" %}

<script>const D={{ data_json }};</script>
<script>
{% include "assets/app.js" %}
