// --- Initial render ---
// Charts are on the overview page (active by default), so they size correctly without tricks
function _initialRender() {
  portfolioChart = buildPortfolioChart();
  benchmarkChart = buildBenchmarkChart();
  updateAll();
  buildHeatmap();
  buildDrawdownChart();
  buildYearlyHeatmap();
  buildYearlyTable();
  buildRollingReturns();
}
if (_eagerLoadPromise) {
  _eagerLoadPromise.then(_initialRender);
} else {
  _initialRender();
}
</script>
