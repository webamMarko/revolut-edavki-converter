<section class="card" id="allocationSection" style="display:none">
  <h2>Portfolio Allocation</h2>
  <div class="allocation-wrap">
    <div class="allocation-chart-col">
      <canvas id="allocationChart"></canvas>
    </div>
    <div class="allocation-legend" id="allocationLegend"></div>
  </div>
</section>

<section class="card" id="positionsSection" style="display:none">
  <h2>Current Positions</h2>
  <div class="table-scroll">
    <table id="positionsTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" id="closedPositionsSection" style="display:none">
  <h2>Closed Positions</h2>
  <div class="table-scroll">
    <table id="closedPositionsTable" class="data-table sortable"></table>
  </div>
</section>
