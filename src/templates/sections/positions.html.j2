{% from "partials/_collapsible_section.html.j2" import collapsible_section %}
<div class="page-stack">
<div class="two-col" data-role="chartsRow">
  <section class="card" data-role="allocationSection" style="display:none">
    <h2>Portfolio Allocation</h2>
    <div class="allocation-wrap">
      <div class="allocation-chart-col">
        <canvas data-role="allocationChart"></canvas>
      </div>
      <div class="allocation-legend" data-role="allocationLegend"></div>
    </div>
  </section>
  <section class="card" data-role="sectorSection" style="display:none">
    <h2 data-role="sectorTitle">Sector Allocation</h2>
    <div class="allocation-wrap">
      <div class="allocation-chart-col">
        <canvas data-role="sectorChart"></canvas>
      </div>
      <div class="allocation-legend" data-role="sectorLegend"></div>
    </div>
  </section>
</div>

{% call collapsible_section('Additional Breakdowns', 'Currency Exposure · Industry Breakdown', 'additional-breakdowns') %}
<div class="two-col">
  <section class="card" data-role="currencySection" style="display:none">
    <h2>Currency Exposure</h2>
    <div class="allocation-wrap">
      <div class="allocation-chart-col">
        <canvas data-role="currencyChart"></canvas>
      </div>
      <div class="allocation-legend" data-role="currencyLegend"></div>
    </div>
  </section>
  <section class="card" data-role="industrySection" style="display:none">
    <h2 data-role="industryTitle">Industry Breakdown</h2>
    <div class="table-scroll">
      <table data-role="industryTable" class="data-table sortable"></table>
    </div>
  </section>
</div>
{% endcall %}

<section class="card" data-role="concentrationSection" style="display:none">
  <h2>Diversification</h2>
  <div data-role="concentrationCards" class="card-grid"></div>
</section>

<section class="card" data-role="correlationSection" style="display:none">
  <h2 data-role="correlationTitle">Position Correlations</h2>
  <p data-role="correlationDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.5rem 0 0.75rem"></p>
  <div class="table-scroll" data-role="correlationGrid"></div>
</section>

<section class="card" data-role="attributionSection" style="display:none">
  <h2>Performance Attribution</h2>
  <div class="table-scroll">
    <table data-role="attributionTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" data-role="positionsSection" style="display:none">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem">
    <h2 style="margin:0">Current Positions</h2>
    <div style="display:flex;gap:0.4rem">
      <button data-role="simulateBtn" class="tax-export-btn" style="font-size:0.72rem;padding:0.3rem 0.7rem">Simulate</button>
      <button data-role="exportPositionsBtn" class="tax-export-btn" style="font-size:0.72rem;padding:0.3rem 0.7rem">Export CSV</button>
    </div>
  </div>
  <div class="table-scroll">
    <table data-role="positionsTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" data-role="closedPositionsSection" style="display:none">
  <h2>Closed Positions</h2>
  <div class="table-scroll">
    <table data-role="closedPositionsTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" data-role="simulatorSection" style="display:none">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem">
    <h2 style="margin:0" data-role="simTitle">What-If Simulator</h2>
    <div style="display:flex;gap:0.4rem;align-items:center">
      <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.72rem;color:var(--muted);cursor:pointer">
        <input type="checkbox" data-role="simTaxEfficientToggle" style="cursor:pointer">
        <span data-role="simTaxEfficientLabel">Tax-efficient (oldest lots first)</span>
      </label>
      <button data-role="simResetBtn" class="tax-export-btn" style="font-size:0.72rem;padding:0.3rem 0.7rem">Reset</button>
      <button data-role="simCloseBtn" class="tax-export-btn" style="font-size:0.72rem;padding:0.3rem 0.7rem">Close</button>
    </div>
  </div>
  <p data-role="simDesc" style="color:var(--muted);font-size:0.8rem;margin:0 0 1rem"></p>
  <div class="two-col">
    <div>
      <div data-role="simCards" class="card-grid small" style="margin-bottom:0.75rem"></div>
      <div class="table-scroll">
        <table data-role="simTable" class="data-table"></table>
      </div>
    </div>
    <div>
      <h3 data-role="simAllocTitle" style="margin:0 0 0.5rem">Resulting Allocation</h3>
      <div class="allocation-wrap">
        <div class="allocation-chart-col">
          <canvas data-role="simChart"></canvas>
        </div>
        <div class="allocation-legend" data-role="simLegend"></div>
      </div>
    </div>
  </div>
</section>
</div>
