<div class="two-col" id="chartsRow">
  <section class="card" id="allocationSection" style="display:none">
    <h2>Portfolio Allocation</h2>
    <div class="allocation-wrap">
      <div class="allocation-chart-col">
        <canvas id="allocationChart"></canvas>
      </div>
      <div class="allocation-legend" id="allocationLegend"></div>
    </div>
  </section>
  <section class="card" id="currencySection" style="display:none">
    <h2>Currency Exposure</h2>
    <div class="allocation-wrap">
      <div class="allocation-chart-col">
        <canvas id="currencyChart"></canvas>
      </div>
      <div class="allocation-legend" id="currencyLegend"></div>
    </div>
  </section>
</div>

<div class="two-col" id="sectorRow" style="display:none">
  <section class="card" id="sectorSection">
    <h2 id="sectorTitle">Sector Allocation</h2>
    <div class="allocation-wrap">
      <div class="allocation-chart-col">
        <canvas id="sectorChart"></canvas>
      </div>
      <div class="allocation-legend" id="sectorLegend"></div>
    </div>
  </section>
  <section class="card" id="industrySection">
    <h2 id="industryTitle">Industry Breakdown</h2>
    <div class="table-scroll">
      <table id="industryTable" class="data-table sortable"></table>
    </div>
  </section>
</div>

<section class="card" id="concentrationSection" style="display:none">
  <h2>Diversification</h2>
  <div id="concentrationCards" class="card-grid"></div>
</section>

<section class="card" id="attributionSection" style="display:none">
  <h2>Performance Attribution</h2>
  <div class="table-scroll">
    <table id="attributionTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" id="positionsSection" style="display:none">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem">
    <h2 style="margin:0">Current Positions</h2>
    <button id="exportPositionsBtn" class="tax-export-btn" style="font-size:0.72rem;padding:0.3rem 0.7rem">Export CSV</button>
  </div>
  <div class="table-scroll">
    <table id="positionsTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" id="closedPositionsSection" style="display:none">
  <h2>Closed Positions</h2>
  <div class="table-scroll">
    <table id="closedPositionsTable" class="data-table sortable"></table>
  </div>
</section>
