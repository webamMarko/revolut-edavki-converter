<div class="page-stack">
<section class="card" data-role="txStatsSection" style="display:none">
  <h2>Trading Activity</h2>
  <div data-role="txStats" class="card-grid"></div>
</section>

<section class="card">
  <h2>Transaction History</h2>
  <div class="toolbar">
    <input type="text" data-role="txFilter" placeholder="Filter by ticker or type…">
    <span data-role="txCount"></span>
  </div>
  <div class="table-scroll">
    <table data-role="txTable" class="data-table sortable"></table>
  </div>
  <div data-role="txPagination" class="pagination"></div>
</section>
</div>
