<div class="page-stack">
<div data-role="divReclaimBadge" style="display:none"></div>

<section class="card" data-role="dividendsSummary">
  <h2>Dividend Income</h2>
  <div class="card-grid" data-role="dividendCards"></div>
</section>

<section class="card" data-role="dividendChartSection">
  <h3>Monthly Income</h3>
  <div class="chart-wrap" style="height:260px">
    <canvas data-role="dividendChart"></canvas>
  </div>
</section>

<section class="card" data-role="dividendGrowthSection" style="display:none">
  <h3>Annual Dividend Income</h3>
  <div class="chart-wrap" style="height:240px">
    <canvas data-role="dividendGrowthChart"></canvas>
  </div>
  <div class="table-scroll" style="margin-top:1rem">
    <table data-role="dividendGrowthTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" data-role="dividendCalendarSection" style="display:none">
  <h3>Dividend Calendar</h3>
  <p style="color:var(--muted);font-size:0.8rem;margin:-0.25rem 0 0.75rem">Upcoming ex-dividend dates and projected income for held positions</p>
  <div data-role="divCalendarCards" class="card-grid small"></div>
  <div data-role="divCalendarAlerts" style="margin-bottom:1rem"></div>
  <div class="chart-wrap" style="height:240px">
    <canvas data-role="divCalendarChart"></canvas>
  </div>
  <div class="table-scroll" style="margin-top:1rem">
    <table data-role="divCalendarTable" class="data-table sortable"></table>
  </div>
</section>

<section class="card" data-role="dividendProjectionSection" style="display:none">
  <h3 data-role="divProjectionTitle">Income Projection</h3>
  <p data-role="divProjectionDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.25rem 0 0.75rem"></p>
  <div data-role="divProjectionCards" class="card-grid small"></div>
  <p data-role="divProjectionBandNote" style="color:var(--muted);font-size:0.75rem;margin:0.5rem 0 0.75rem"></p>
  <div class="chart-wrap" style="height:260px">
    <canvas data-role="dividendProjectionChart"></canvas>
  </div>
</section>

<section class="card" data-role="dividendTableSection">
  <h3>Income by Ticker</h3>
  <div class="table-scroll">
    <table data-role="dividendTable" class="data-table sortable"></table>
  </div>
</section>
</div>
