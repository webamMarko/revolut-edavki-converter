<div class="proj-subtabs" data-role="projSubtabs">
  <button class="proj-subtab active" data-proj-tab="montecarlo">Monte Carlo</button>
  <button class="proj-subtab" data-proj-tab="fire">FIRE</button>
  <button class="proj-subtab" data-proj-tab="dividend">Dividend</button>
  <button class="proj-subtab" data-proj-tab="goals">Goals</button>
</div>

<div class="page-stack">
  <section class="card proj-tab-content" data-proj-panel="montecarlo" data-role="monteCarloSection" style="display:none">
    <div class="chart-header">
      <h2 data-role="mcTitle">Monte Carlo Projection</h2>
      <div class="range-bar" data-role="mcHorizonBar"></div>
    </div>
    <p data-role="mcDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.25rem 0 0.75rem"></p>
    <div data-role="mcCards" class="card-grid small" style="margin-bottom:0.75rem"></div>
    <div class="chart-wrap" style="height:300px"><canvas data-role="mcChart"></canvas></div>
  </section>

  <section class="card proj-tab-content" data-proj-panel="fire" data-role="fireSection" style="display:none">
    <h2>FIRE Projection</h2>
    <div class="fire-config" style="display:flex;gap:0.75rem 1.25rem;flex-wrap:wrap;align-items:center;font-size:0.82rem;color:var(--muted);margin-bottom:1rem">
      <label style="display:flex;align-items:center;gap:0.35rem">Annual expenses
        <input data-role="projFireExpenses" type="number" class="fire-input" step="500" min="0" style="width:90px">
      </label>
      <label style="display:flex;align-items:center;gap:0.35rem">Annual income
        <input data-role="projFireIncome" type="number" class="fire-input" step="500" min="0" style="width:90px">
      </label>
      <label style="display:flex;align-items:center;gap:0.35rem">Withdrawal rate %
        <input data-role="projFireWithdrawal" type="number" class="fire-input" step="0.1" min="0.1" max="20" style="width:70px">
      </label>
      <label style="display:flex;align-items:center;gap:0.35rem">Inflation %
        <input data-role="projFireInflation" type="number" class="fire-input" step="0.1" min="0" max="20" style="width:70px">
      </label>
      <label style="display:flex;align-items:center;gap:0.35rem">Monthly investment
        <input data-role="projFireContrib" type="number" class="fire-input" step="50" min="0" style="width:90px">
      </label>
    </div>
    <div data-role="fireCards" class="metric-cards-row" style="margin-bottom:1rem"></div>
    <div class="chart-wrap" style="height:300px"><canvas data-role="fireChart"></canvas></div>
    <button class="coll-panel-hdr" aria-expanded="false" aria-controls="fire-additional-metrics">
      Additional Metrics
      <svg class="coll-panel-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg>
    </button>
    <div class="coll-panel-body" id="fire-additional-metrics">
      <div data-role="fireSecondaryCards" class="card-grid small" style="padding:0.75rem 0"></div>
    </div>
  </section>

  <section class="card proj-tab-content" data-proj-panel="dividend" data-role="projDividendSection" style="display:none">
    <h3 data-role="projDivTitle">Dividend Income Projection</h3>
    <p data-role="projDivDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.25rem 0 0.75rem"></p>
    <div data-role="projDivCards" class="card-grid small"></div>
    <p data-role="projDivBandNote" style="color:var(--muted);font-size:0.75rem;margin:0.5rem 0 0.75rem"></p>
    <div class="chart-wrap" style="height:280px">
      <canvas data-role="projDividendChart"></canvas>
    </div>
  </section>

  <section class="card proj-tab-content" data-proj-panel="goals" data-role="projGoalsSection" style="display:none">
    <h3>Goal Projections</h3>
    <p style="color:var(--muted);font-size:0.8rem;margin:-0.25rem 0 0.75rem">Monte Carlo simulations for each investment goal.</p>
    <div data-role="projGoalsList"></div>
    <div data-role="projGoalsEmpty" class="empty-state-box" style="display:none">
      <p style="color:var(--muted);font-size:0.85rem">No investment goals set. Create goals from the sidebar to see projections here.</p>
    </div>
  </section>
</div>
