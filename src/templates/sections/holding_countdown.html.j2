<section class="card" data-role="holdingCountdownSection" style="display:none">
  <div class="chart-header">
    <h2 data-role="holdingCountdownTitle">Holding Period Countdown</h2>
  </div>
  <p data-role="holdingCountdownDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.5rem 0 1rem"></p>

  <!-- Upcoming milestones highlight -->
  <div data-role="holdingCountdownHighlight" class="card-grid small"></div>

  <!-- Per-lot countdown table -->
  <div class="table-scroll" style="margin-top:1rem">
    <table data-role="holdingCountdownTable" class="data-table sortable"></table>
  </div>
</section>
