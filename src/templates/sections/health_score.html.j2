<section data-role="healthScoreSection" class="card health-score-card" style="display:none">
  <div class="health-score-header">
    <div class="health-score-title-row">
      <h2>Portfolio Health</h2>
      <div class="health-score-badge" data-role="healthScoreBadge">
        <span class="health-score-grade" data-role="healthScoreGrade">—</span>
        <span class="health-score-num" data-role="healthScoreNum">—</span>
      </div>
    </div>
    <div class="health-score-label" data-role="healthScoreLabel"></div>
    <div class="health-score-bar-wrap">
      <div class="health-score-bar-track">
        <div class="health-score-bar-fill" data-role="healthScoreBarFill"></div>
      </div>
    </div>
  </div>

  <div class="health-sub-scores" data-role="healthSubScores"></div>

  <div class="health-actions" data-role="healthActions" style="display:none">
    <h3 class="health-actions-title">Recommended Actions</h3>
    <div class="health-actions-list" data-role="healthActionsList"></div>
  </div>
</section>
