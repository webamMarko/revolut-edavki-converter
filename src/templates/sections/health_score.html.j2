<section id="healthScoreSection" class="card health-score-card" style="display:none">
  <div class="health-score-header">
    <div class="health-score-title-row">
      <h2>Portfolio Health</h2>
      <div class="health-score-badge" id="healthScoreBadge">
        <span class="health-score-grade" id="healthScoreGrade">—</span>
        <span class="health-score-num" id="healthScoreNum">—</span>
      </div>
    </div>
    <div class="health-score-label" id="healthScoreLabel"></div>
    <div class="health-score-bar-wrap">
      <div class="health-score-bar-track">
        <div class="health-score-bar-fill" id="healthScoreBarFill"></div>
      </div>
    </div>
  </div>

  <div class="health-sub-scores" id="healthSubScores"></div>

  <div class="health-actions" id="healthActions" style="display:none">
    <h3 class="health-actions-title">Recommended Actions</h3>
    <div class="health-actions-list" id="healthActionsList"></div>
  </div>
</section>
