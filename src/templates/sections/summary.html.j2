<div data-role="selectionBanner" class="selection-banner" style="display:none">
  <span data-role="selectionLabel"></span>
  <button onclick="resetZoom()">Reset</button>
</div>

<div data-role="taxSeasonBanner" class="tax-season-banner" style="display:none" onclick="window.switchPage('tax');setTimeout(function(){if(window.switchTaxSubtab)window.switchTaxSubtab('file')},150)">
  <span class="tax-season-banner-icon">&#128203;</span>
  <span class="tax-season-banner-text">It's tax season! <strong>File your taxes</strong> for the previous year using our step-by-step wizard.</span>
  <button class="tax-season-banner-btn">File My Taxes</button>
</div>

<div data-role="taxNudgeWidget" style="display:none"></div>
<div data-role="edavkiDeadlineWidget" style="display:none"></div>
<div data-role="dividendNudgeWidget" style="display:none"></div>

<div class="page-stack">
  <section data-role="summary" class="card-grid"></section>

  <section data-role="milestonesSection" class="milestones-strip-wrap" style="display:none">
    <div data-role="milestonesStrip" class="milestones-strip"></div>
    <div data-role="milestonesList" class="milestones-list" style="display:none"></div>
  </section>

  <section data-role="achievementsSection" class="card" style="display:none">
    <h3 class="ach-section-title">Achievements</h3>
    <div data-role="achievementsGrid" class="ach-grid"></div>
  </section>

  <section class="chart-section">
    <div class="chart-header">
      <h2>Portfolio Value</h2>
      <div class="range-bar" data-role="rangeBar">
        <button class="range-btn" data-days="7">7D</button>
        <button class="range-btn" data-days="30">30D</button>
        <button class="range-btn" data-ytd="1">YTD</button>
        <button class="range-btn" data-days="365">1Y</button>
        <button class="range-btn" data-days="1095">3Y</button>
        <button class="range-btn" data-days="1825">5Y</button>
        <button class="range-btn active" data-days="-1">All</button>
      </div>
      <span class="chart-hint">Drag to select a period</span>
    </div>
    <div class="chart-wrap"><canvas data-role="portfolioChart"></canvas></div>
  </section>

  <section class="two-col" data-role="topMoversSection" style="display:none">
    <div class="card">
      <h3>Top Gainers</h3>
      <div data-role="topGainers" class="movers-list"></div>
    </div>
    <div class="card">
      <h3>Top Losers</h3>
      <div data-role="topLosers" class="movers-list"></div>
    </div>
  </section>

  <section class="two-col">
    <div class="card">
      <h2>Gains Breakdown</h2>
      <table data-role="gainsTable" class="data-table"></table>
      <div data-role="gainsChartWrap" style="height:180px;margin-top:0.5rem;display:none">
        <canvas data-role="gainsChart"></canvas>
      </div>
    </div>
    <div class="card" data-role="benchmarkTableCard" style="display:none">
      <h2>Benchmark Comparison</h2>
      <table data-role="benchmarkTable" class="data-table"></table>
    </div>
  </section>

  {% include "sections/attribution.html.j2" %}
</div>
