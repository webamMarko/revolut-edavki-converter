<section class="card chart-section" data-role="whatifSection" style="display:none">
  <div class="whatif-header">
    <h2>What If I Had Bought...</h2>
    <div class="whatif-controls">
      <select data-role="whatifBenchmark" class="whatif-select">
        <option value="">Select a benchmark</option>
      </select>
    </div>
  </div>

  <div data-role="whatifResult" style="display:none">
    <div data-role="whatifSummaryCard" class="whatif-summary"></div>
    <div class="chart-wrap" style="height:320px"><canvas data-role="whatifChart"></canvas></div>
    <div data-role="whatifYearBreakdown" class="whatif-year-breakdown" style="display:none">
      <h3>Yearly Breakdown</h3>
      <table data-role="whatifYearTable" class="data-table"></table>
    </div>
  </div>

  <div data-role="whatifEmpty" class="whatif-empty">
    <p>Select a benchmark above to see how your portfolio would have performed if you had invested all your money into it instead.</p>
    <p class="muted">Uses your actual deposit and withdrawal dates and amounts.</p>
  </div>
</section>
