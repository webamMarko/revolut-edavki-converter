<section class="card" data-role="taxSection" style="display:none">
  <div class="chart-header">
    <h2>Tax Summary</h2>
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;margin-left:auto">
      <div class="range-bar" data-role="taxYearBar"></div>
      <button data-role="taxCompareToggle" class="range-btn" title="Compare tax regimes side-by-side">&#8646; Compare</button>
    </div>
  </div>
  <div data-role="taxCompareBar" style="display:none;align-items:center;gap:0.5rem;padding:0.5rem 0;flex-wrap:wrap">
    <span style="font-size:0.75rem;color:var(--muted);font-weight:600">Compare with:</span>
    <select data-role="taxCompareSelect" class="regime-select" style="width:auto;min-width:160px"></select>
  </div>
  <div data-role="taxCards" class="card-grid small"></div>
  <div data-role="taxCompareTable" style="display:none;margin-bottom:1rem"></div>
  <div data-role="taxExportBar" class="tax-export-bar" style="display:none">
    <select data-role="taxExportSelect" class="tax-export-select">
      <option value="edavki">eDavki XML (Doh-KDVP)</option>
      <option value="fifo-csv">FIFO Transactions CSV</option>
      <option value="tax-pdf">Tax Summary PDF</option>
    </select>
    <button data-role="taxExportBtn" class="tax-export-btn">Export</button>
  </div>
  <div class="table-scroll">
    <table data-role="taxTable" class="data-table sortable"></table>
  </div>
  <div data-role="taxPagination" class="pagination"></div>
</section>

<section class="card" data-role="dividendTaxSection" style="display:none">
  <div class="chart-header">
    <h2>Dividend Tax (Doh-Div)</h2>
    <div class="range-bar" data-role="divTaxYearBar"></div>
  </div>
  <div data-role="divTaxCards" class="card-grid small"></div>
  <div data-role="divTaxExportBar" class="tax-export-bar" style="display:none">
    <button data-role="divTaxExportBtn" class="tax-export-btn">Export Doh-Div XML</button>
  </div>
  <div data-role="divTaxCountryBreakdown" class="table-scroll">
    <table data-role="divTaxTable" class="data-table"></table>
  </div>
  <div data-role="divTaxPagination" class="pagination"></div>
  <div data-role="divTaxGuidance" class="tax-guidance" style="margin-top:1rem"></div>
</section>

<section class="card" data-role="harvestSection" style="display:none">
  <h2 data-role="harvestTitle">Tax-Loss Harvesting Opportunities</h2>
  <p data-role="harvestDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.5rem 0 1rem"></p>
  <div data-role="harvestCards" class="card-grid small"></div>
  <div class="table-scroll">
    <table data-role="harvestTable" class="data-table sortable"></table>
  </div>
</section>
