<section class="card" data-role="yearEndCalendarSection">
  <div class="chart-header">
    <h2 data-role="yearEndCalendarTitle">Year-End Tax Action Calendar</h2>
  </div>
  <p data-role="yearEndCalendarDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.5rem 0 1rem"></p>

  <!-- Summary highlight cards -->
  <div data-role="yearEndCalendarHighlight" class="card-grid small" style="margin-bottom:1.25rem"></div>

  <!-- Action timeline (horizontal bar per month) -->
  <div data-role="yearEndTimelineSection" style="margin-bottom:1.5rem">
    <h3 data-role="yearEndTimelineTitle" style="font-size:0.85rem;font-weight:600;margin:0 0 0.75rem;color:var(--muted)"></h3>
    <div data-role="yearEndTimeline" style="position:relative;overflow-x:auto"></div>
  </div>

  <!-- Action checklist table -->
  <div data-role="yearEndActionsSection">
    <!-- Urgent -->
    <div data-role="yearEndGroupUrgent" style="display:none;margin-bottom:1.25rem">
      <h3 data-role="yearEndGroupUrgentTitle" style="font-size:0.85rem;font-weight:700;color:var(--neg);margin:0 0 0.5rem"></h3>
      <div class="table-scroll">
        <table data-role="yearEndTableUrgent" class="data-table"></table>
      </div>
    </div>
    <!-- Soon -->
    <div data-role="yearEndGroupSoon" style="display:none;margin-bottom:1.25rem">
      <h3 data-role="yearEndGroupSoonTitle" style="font-size:0.85rem;font-weight:700;color:var(--warn,#f59e0b);margin:0 0 0.5rem"></h3>
      <div class="table-scroll">
        <table data-role="yearEndTableSoon" class="data-table"></table>
      </div>
    </div>
    <!-- Before year-end -->
    <div data-role="yearEndGroupYearend" style="display:none;margin-bottom:1.25rem">
      <h3 data-role="yearEndGroupYearendTitle" style="font-size:0.85rem;font-weight:700;color:var(--text);margin:0 0 0.5rem"></h3>
      <div class="table-scroll">
        <table data-role="yearEndTableYearend" class="data-table"></table>
      </div>
    </div>
    <!-- Loss harvest -->
    <div data-role="yearEndGroupHarvest" style="display:none;margin-bottom:1.25rem">
      <h3 data-role="yearEndGroupHarvestTitle" style="font-size:0.85rem;font-weight:700;color:var(--accent);margin:0 0 0.5rem"></h3>
      <div class="table-scroll">
        <table data-role="yearEndTableHarvest" class="data-table"></table>
      </div>
    </div>
    <!-- Hold (don't sell) -->
    <div data-role="yearEndGroupHold" style="display:none;margin-bottom:1.25rem">
      <h3 data-role="yearEndGroupHoldTitle" style="font-size:0.85rem;font-weight:700;color:var(--muted);margin:0 0 0.5rem"></h3>
      <div class="table-scroll">
        <table data-role="yearEndTableHold" class="data-table"></table>
      </div>
    </div>
  </div>

  <!-- Empty state -->
  <div data-role="yearEndCalendarEmpty" style="display:none;text-align:center;color:var(--muted);padding:2rem">
    <p data-role="yearEndCalendarEmptyMsg"></p>
  </div>
</section>
