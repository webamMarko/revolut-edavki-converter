<div id="quickGlance" class="quick-glance" style="display:none">
  <div class="qg-main">
    <div class="qg-value" id="qgValue">--</div>
    <div class="qg-label">Portfolio Value</div>
    <div class="qg-change" id="qgChange">
      <span class="qg-change-amount" id="qgChangeAmount">--</span>
      <span class="qg-change-pct" id="qgChangePct">--</span>
    </div>
    <div class="qg-sparkline-wrap">
      <canvas id="qgSparkline" height="40"></canvas>
    </div>
  </div>

  <div class="qg-movers" id="qgMovers">
    <div class="qg-section-label">Top Movers</div>
    <div class="qg-movers-list" id="qgMoversList"></div>
  </div>

  <div class="qg-actions" id="qgActions" style="display:none">
    <div class="qg-actions-badge" id="qgActionsBadge">0</div>
    <div class="qg-actions-label">Pending actions</div>
  </div>

  <button class="qg-expand-btn" id="qgExpandBtn" aria-label="Show full dashboard">
    <svg viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="4,6 8,10 12,6"/></svg>
    <span>Full Dashboard</span>
  </button>

  <label class="qg-toggle-label" id="qgToggleLabel">
    <input type="checkbox" id="qgAlwaysToggle">
    <span>Always show Quick Glance on mobile</span>
  </label>
</div>
