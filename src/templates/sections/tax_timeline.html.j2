<section class="card" id="taxTimelineSection" style="display:none">
  <div class="chart-header">
    <h2 id="taxTimelineTitle">Tax Timeline</h2>
  </div>
  <p id="taxTimelineDesc" style="color:var(--muted);font-size:0.8rem;margin:-0.5rem 0 1rem"></p>

  <!-- Sort controls -->
  <div class="range-bar" id="taxTimelineSortBar" style="margin-bottom:1rem">
    <button class="range-btn active" data-sort="days">Days to next</button>
    <button class="range-btn" data-sort="size">Position size</button>
    <button class="range-btn" data-sort="savings">Potential savings</button>
  </div>

  <!-- Bracket color legend -->
  <div id="taxTimelineLegend" style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.75rem;font-size:0.75rem">
    <span style="display:inline-flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;border-radius:2px;background:rgba(248,113,113,0.7)"></span>25%</span>
    <span style="display:inline-flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;border-radius:2px;background:rgba(251,146,60,0.7)"></span>20%</span>
    <span style="display:inline-flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;border-radius:2px;background:rgba(250,204,21,0.7)"></span>15%</span>
    <span style="display:inline-flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;border-radius:2px;background:rgba(52,211,153,0.7)"></span>10%</span>
    <span style="display:inline-flex;align-items:center;gap:0.25rem"><span style="width:12px;height:12px;border-radius:2px;background:rgba(96,165,250,0.7)"></span>0%</span>
    <span style="color:var(--muted);margin-left:0.5rem">Solid = held | Faded = remaining</span>
  </div>

  <!-- Timeline chart -->
  <div class="chart-wrap" style="height:auto;min-height:200px;max-height:600px;overflow-y:auto">
    <canvas id="taxTimelineCanvas"></canvas>
  </div>

  <!-- What-if panel (shown on bar click) -->
  <div id="taxTimelineWhatIf" class="card" style="display:none;margin-top:1rem;padding:1rem;border:1px solid var(--border);border-radius:var(--radius)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem">
      <h3 id="taxTimelineWhatIfTitle" style="margin:0;font-size:0.95rem">What-If Analysis</h3>
      <button id="taxTimelineWhatIfClose" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.2rem">&times;</button>
    </div>
    <div id="taxTimelineWhatIfCards" class="card-grid small"></div>
    <div id="taxTimelineWhatIfNote" style="margin-top:0.75rem;font-size:0.8rem;color:var(--muted);line-height:1.4"></div>
  </div>
</section>
