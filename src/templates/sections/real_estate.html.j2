<div class="page-stack">
<section class="card" data-role="realEstateSection" style="display:none">
  <h2>Real Estate <a href="/properties" data-role="reManageLink" style="font-size:.8rem;font-weight:500;margin-left:.75rem;color:var(--link-color,#3b82f6)">Manage Properties &rarr;</a></h2>
  <div data-role="reEmptyState" class="re-empty-state" style="display:none"></div>
  <div data-role="reCards" class="card-grid small" style="margin-bottom:0.5rem"></div>
  <div data-role="reMetricsToggle" class="re-metrics-toggle-wrap" style="margin-bottom:0.5rem"></div>
  <div data-role="reCardsSecondary" class="card-grid small" style="display:none;margin-bottom:1rem"></div>
  <div data-role="reTimeRange" class="re-time-range-wrap" style="margin-bottom:0.5rem"></div>
  <div class="chart-wrap" style="height:260px;margin-bottom:1rem"><canvas data-role="reChart"></canvas></div>
  <div class="property-details-accordion">
    <div id="property-details-header"
         class="property-details-header"
         role="button"
         aria-expanded="false"
         aria-controls="property-details-panel"
         tabindex="0">
      <span class="property-details-title">Property Details</span>
      <span class="property-details-chevron">&#8250;</span>
    </div>
    <div id="property-details-panel"
         class="property-details-panel"
         role="region"
         aria-labelledby="property-details-header">
      <div class="property-details-inner">
        <div class="table-scroll">
          <table data-role="reTable" class="data-table"></table>
        </div>
      </div>
    </div>
  </div>
</section>
</div>
