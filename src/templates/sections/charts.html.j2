<div class="page-stack">
  <div class="two-col heatmap-row">
    <section class="card">
      <h2>Monthly Performance</h2>
      <div class="heatmap-wrap"><div id="heatmap"></div></div>
    </section>
    <section class="card">
      <h2>Yearly Performance</h2>
      <div class="heatmap-wrap"><div id="yearly-heatmap"></div></div>
    </section>
  </div>

  <section class="card" id="yearlyTableSection">
    <h2>Annual Summary</h2>
    <div class="table-scroll">
      <table id="yearlyTable" class="data-table sortable"></table>
    </div>
  </section>

  <section class="chart-section" id="benchmarkSection" style="display:none">
    <h2 id="benchmarkSectionTitle">Performance vs Benchmarks</h2>
    <div class="chart-wrap"><canvas id="benchmarkChart"></canvas></div>
  </section>

  {% include "sections/whatif.html.j2" %}

  <section class="card chart-section" id="rollingReturnsSection" style="display:none">
    <h2>Rolling 1-Year Returns</h2>
    <div class="chart-wrap" style="height:240px"><canvas id="rollingReturnsChart"></canvas></div>
  </section>

  <section id="riskMetricsSection" class="card" style="display:none">
    <h2>Risk Metrics</h2>
    <div id="riskMetrics" class="card-grid"></div>
  </section>

  <section class="card chart-section" id="drawdownSection" style="display:none">
    <h2>Drawdown from Peak</h2>
    <div class="chart-wrap" style="height:200px"><canvas id="drawdownChart"></canvas></div>
  </section>
</div>
